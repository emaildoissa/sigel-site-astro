---
interface Props {
  whatsappUrl?: string;
  phoneUrl?: string;
  whatsappText?: string;
  phoneText?: string;
  badge?: string;
}

const {
  whatsappUrl = "https://wa.me/5551993257923?text=Ol%C3%A1%21%20Estava%20no%20site%20da%20Sigel%20e%20gostaria%20de%20um%20or%C3%A7amento.",
  phoneUrl = "tel:+5551993257923",
  whatsappText = "Chamar no WhatsApp",
  phoneText = "Ligar Agora",
  badge = "Atendimento Rápido em Porto Alegre",
} = Astro.props;
---

<div
  class="md:hidden fixed bottom-0 left-0 right-0 z-50 p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] bg-black/90 backdrop-blur-xl border-t border-white/10 shadow-[0_-10px_25px_rgba(0,0,0,0.5)] transition-transform duration-300"
  id="mobile-sticky-cta"
>
  {badge && (
    <div class="flex items-center justify-center gap-1.5 pb-2 text-[11px] font-semibold text-gray-400">
      <span class="w-2 h-2 rounded-full bg-green-500 animate-ping inline-block"></span>
      <span>{badge}</span>
    </div>
  )}

  <div class="grid grid-cols-2 gap-2.5">
    {/* Botão Ligar */}
    <a
      href={phoneUrl}
      class="flex items-center justify-center gap-2 bg-white/10 hover:bg-white/15 active:scale-95 text-white font-bold text-sm py-3 px-3 rounded-xl border border-white/15 transition-all shadow-md"
      aria-label="Ligar para a Sigel Informática"
    >
      <span class="material-symbols-outlined text-[20px] text-primary">call</span>
      <span class="truncate">{phoneText}</span>
    </a>

    {/* Botão WhatsApp */}
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 bg-gradient-to-r from-[#128C7E] to-[#25D366] hover:from-[#0e6f64] hover:to-[#20bd5a] active:scale-95 text-white font-black text-sm py-3 px-3 rounded-xl shadow-lg shadow-green-500/25 transition-all"
      aria-label="Enviar mensagem no WhatsApp"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 448 512"
        class="w-4 h-4 fill-current shrink-0"
      >
        <path
          d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L3 472l110.3-28.8c32.5 17.7 68.9 27 106.1 27 122.4 0 222-99.6 222-222 0-59.3-23.2-115-65.1-157.1zM223.9 438.5c-33.1 0-65.7-8.9-94.1-25.7l-6.7-4-69.8 18.3 18.7-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
        ></path>
      </svg>
      <span class="truncate">{whatsappText}</span>
    </a>
  </div>
</div>
