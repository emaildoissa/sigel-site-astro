      <div class="flex items-center gap-4 text-[11px] text-gray-500">
        <span>Porto Alegre • Brasil</span>
        <span class="hidden md:inline">•</span>
        <span>Atendimento remoto em todo o Brasil</span>
      </div>
    </div>
  </div>
</footer>

<div
  class="wpp-float-container fixed right-6 md:right-8 z-[60] flex flex-col items-end gap-3"
>
  {/* Tooltip */}
  <div
    class="opacity-0 group-hover:opacity-100 transition-opacity bg-gray-900 text-white text-xs font-semibold px-3 py-1.5 rounded-lg shadow-lg whitespace-nowrap pointer-events-none hidden md:block"
    id="wpp-tooltip"
  >
    Fale conosco
  </div>

  {/* Botão */}
  <div class="relative group">
    {/* Anel animado externo */}
    <span
      class="absolute inset-0 rounded-full bg-[#25D366] animate-ping opacity-30"
    ></span>

    <a
      href="https://wa.me/5551993257923"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Falar no WhatsApp"
      class="relative flex items-center justify-center w-14 md:w-16 h-14 md:h-16 bg-gradient-to-tr from-[#128C7E] to-[#25D366] hover:from-[#0e6f64] hover:to-[#20bd5a] text-white rounded-full shadow-[0_10px_25px_-5px_rgba(37,211,102,0.4),0_8px_10px_-6px_rgba(37,211,102,0.4)] hover:shadow-[0_20px_35px_-5px_rgba(37,211,102,0.6)] border border-white/10 transition-all duration-300 hover:scale-110 hover:rotate-[6deg] active:scale-95"
      onmouseenter="document.getElementById('wpp-tooltip').style.opacity='1'"
      onmouseleave="document.getElementById('wpp-tooltip').style.opacity='0'"
    >
      {/* Logo oficial do WhatsApp */}
      <svg
        viewBox="0 0 448 512"
        xmlns="http://www.w3.org/2000/svg"
        class="w-7 h-7 md:w-8 md:h-8"
        fill="white"
      >
        <path
