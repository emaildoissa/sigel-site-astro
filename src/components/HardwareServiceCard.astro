---
export interface Props {
  icon: string;
  title: string;
  description: string;
  href?: string;
  price?: string;
  badge?: string;
}

const { icon, title, description, href, price, badge } = Astro.props;
const CardTag = href ? "a" : "div";
---

<CardTag
  href={href}
  class={`group relative overflow-hidden rounded-2xl bg-surface-dark border border-white/10 p-6 md:p-8 shadow-lg transition-all duration-300 hover:border-primary/50 hover:shadow-2xl hover:shadow-primary/10 hover:-translate-y-1.5 flex flex-col justify-between ${href ? "cursor-pointer" : ""}`}
>
  {/* Radial Glow on Hover */}
  <div class="absolute -right-12 -top-12 w-32 h-32 bg-primary/10 rounded-full blur-2xl group-hover:bg-primary/20 transition-all duration-500 pointer-events-none"></div>

  {/* Dotted Background Pattern */}
  <div
    class="absolute inset-0 opacity-10 group-hover:opacity-20 transition-opacity pointer-events-none"
    style="background-image: radial-gradient(rgba(246,94,55,0.4) 1px, transparent 1px); background-size: 20px 20px;"
  ></div>

  {/* Content */}
  <div class="relative z-10 flex flex-col h-full gap-4">
    <div class="flex items-start justify-between gap-3">
      {/* Icon */}
      <div class="flex h-14 w-14 md:h-16 md:w-16 items-center justify-center rounded-2xl bg-primary/15 border border-primary/30 text-primary shadow-lg shadow-primary/10 group-hover:scale-110 group-hover:bg-primary group-hover:text-white transition-all duration-300 shrink-0">
        <span class="material-symbols-outlined text-[30px] md:text-[34px]">{icon}</span>
      </div>

      {badge && (
        <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-accent/15 border border-accent/30 text-accent">
          {badge}
        </span>
      )}
    </div>

    {/* Title */}
    <h3 class="text-xl font-bold text-white group-hover:text-primary transition-colors duration-200">
      {title}
    </h3>

    {/* Description */}
    <p class="text-gray-400 text-sm md:text-base leading-relaxed flex-1">
      {description}
    </p>

    {/* Price & CTA */}
    <div class="pt-3 border-t border-white/10 flex items-center justify-between mt-auto">
      {price ? (
        <div>
          <span class="text-[11px] uppercase tracking-wider text-gray-500 block font-semibold">Valor estimado</span>
          <span class="text-sm md:text-base font-black text-white">{price}</span>
        </div>
      ) : (
        <span class="text-xs text-gray-400 font-medium">Sob consulta</span>
      )}

      {href && (
        <span class="inline-flex items-center gap-1 text-sm font-bold text-primary group-hover:text-accent transition-colors">
          <span>Ver Detalhes</span>
          <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
        </span>
      )}
    </div>
  </div>
</CardTag>