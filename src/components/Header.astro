---
const currentPath = Astro.url.pathname;
const isActive = (path: string) =>
  currentPath === path ||
  (path === "/servicos" && currentPath.startsWith("/servicos")) ||
  (path === "/blog" && currentPath.startsWith("/blog")) ||
  (path === "/contratos" && currentPath.startsWith("/contratos"));
const navLinks = [
  { label: "Início", href: "/" },
  { label: "Serviços", href: "/servicos" },
  { label: "Onde Estamos", href: "/onde-estamos" },
  { label: "Contratos", href: "/contratos" },
  { label: "Planos", href: "/planos" },
  { label: "Blog", href: "/blog" },
  { label: "Sobre nós", href: "/sobre" },
];
const telefone = "5551993257923";
const whatsappMsg = encodeURIComponent(
  "Olá! Estava no site da Sigel e gostaria de solicitar um diagnóstico gratuito para o meu negócio.",
);
const whatsappUrl = `https://wa.me/${telefone}?text=${whatsappMsg}`;
---

<header
  class="sticky top-0 z-50 w-full bg-surface-dark/95 backdrop-blur-md shadow-md border-b border-white/5 transition-all"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12 py-2 md:py-3.5 flex flex-col md:flex-row items-center justify-between w-full"
  >
    <div
      class="flex items-center gap-3 md:gap-4 w-full md:w-auto justify-between md:justify-start"
    >
      <div class="flex items-center gap-2.5 sm:gap-4">
        {
          currentPath !== "/" && (
            <button
              onclick="window.history.back()"
              aria-label="Voltar"
              class="text-white flex size-9 sm:size-10 items-center justify-center rounded-full hover:bg-white/10 active:scale-95 transition-all"
            >
              <span class="material-symbols-outlined text-[20px] sm:text-[24px]">arrow_back</span>
            </button>
          )
        }
        <a href="/" class="cursor-pointer flex items-center">
          <picture>
            <source srcset="/images/logo.webp" type="image/webp" />
            <img
              src="/images/logo.webp"
              alt="Sigel Soluções em Informática"
              width="283"
              height="170"
              class="h-10 sm:h-12 md:h-24 lg:h-28 w-auto object-contain py-0.5 md:py-1 transition-all"
            />
          </picture>
        </a>
      </div>

      <button
        id="menu-toggle"
        class="md:hidden flex items-center justify-center size-10 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 active:scale-95 transition-all text-white"
        aria-label="Abrir Menu"
      >
        <span class="material-symbols-outlined text-[24px]"
          >menu</span
        >
      </button>
    </div>

    <nav class="hidden md:flex items-center gap-8 mt-4 md:mt-0">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={`text-sm font-semibold transition-colors ${isActive(link.href) ? "text-primary" : "text-gray-300 hover:text-white"}`}
          >
            {link.label}
          </a>
        ))
      }

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 bg-accent hover:bg-accent-dark text-white px-5 py-2.5 rounded-lg font-bold text-sm ml-4 transition-all hover:scale-105 shadow-[0_0_15px_rgba(246,94,55,0.2)] ring-2 ring-accent/40 animate-pulse group"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          fill="currentColor"
          viewBox="0 0 16 16"
          class="transition-transform group-hover:scale-110"
        >
          <path
            d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"
          ></path>
        </svg>
        Diagnóstico Gratuito
      </a>
    </nav>
  </div>

  {/* Menu Mobile Aperfeiçoado */}
  <nav
    id="mobile-nav"
    class="md:hidden hidden flex flex-col gap-2 bg-surface-dark/98 backdrop-blur-xl w-full px-4 py-5 border-t border-white/10 shadow-2xl max-h-[calc(100vh-4.5rem)] overflow-y-auto"
  >
    <div class="flex flex-col gap-1.5">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={`flex items-center justify-between min-h-[44px] px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all ${
              isActive(link.href)
                ? "bg-primary/15 text-primary border border-primary/30 font-bold"
                : "text-gray-300 hover:text-white hover:bg-white/5"
            }`}
          >
            <span>{link.label}</span>
            <span class="material-symbols-outlined text-[18px] opacity-60">chevron_right</span>
          </a>
        ))
      }
    </div>

    <div class="pt-3 mt-2 border-t border-white/10 flex flex-col gap-2.5">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 bg-accent hover:bg-accent-dark text-white py-3 px-4 w-full rounded-xl font-bold text-sm shadow-lg shadow-accent/20 transition-transform active:scale-95 group"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          fill="currentColor"
          viewBox="0 0 16 16"
          class="transition-transform group-hover:scale-110"
        >
          <path
            d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"
          ></path>
        </svg>
        Falar no WhatsApp
      </a>

      <div class="flex items-center justify-between text-xs text-gray-400 px-1 pt-1">
        <span>Av. Icaraí, 1428 - Cristal</span>
        <a href="tel:+555135083008" class="text-primary hover:underline">(51) 3508-3008</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");
  if (toggle && mobileNav) {
    toggle.addEventListener("click", () => {
      const opening = mobileNav.classList.contains("hidden");
      mobileNav.classList.toggle("hidden");
      const icon = toggle.querySelector(".material-symbols-outlined");
      if (icon) icon.textContent = opening ? "close" : "menu";
    });

    // Close menu when clicking on any link inside the mobile menu
    const mobileLinks = mobileNav.querySelectorAll("a");
    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileNav.classList.add("hidden");
        const icon = toggle.querySelector(".material-symbols-outlined");
        if (icon) icon.textContent = "menu";
      });
    });
  }
</script>
