---
import type { CollectionEntry } from "astro:content";

export interface Props {
  post: CollectionEntry<"blog">;
  index?: number;
}

const { post, index = 0 } = Astro.props;

const categoryColors: Record<string, string> = {
  web: "#f65e37",
  hardware: "#3b82f6",
  automacao: "#10b981",
  copywriting: "#8b5cf6",
  negocios: "#f59e0b",
};

const categoryLabels: Record<string, string> = {
  web: "Web",
  hardware: "Hardware",
  automacao: "Automação",
  copywriting: "Copywriting",
  negocios: "Negócios",
};

const cat = post.data.category || "web";
const catColor = categoryColors[cat] || "#f65e37";

const placeholderGradients: Record<string, string> = {
  web: "linear-gradient(135deg, #1a110e 0%, #2a1810 50%, #1a110e 100%)",
  hardware: "linear-gradient(135deg, #0e121a 0%, #10182a 50%, #0e121a 100%)",
  automacao: "linear-gradient(135deg, #0e1a12 0%, #102a18 50%, #0e1a12 100%)",
  copywriting: "linear-gradient(135deg, #120e1a 0%, #1a102a 50%, #120e1a 100%)",
  negocios: "linear-gradient(135deg, #1a160e 0%, #2a2210 50%, #1a160e 100%)",
};

const placeholderBg = placeholderGradients[cat] || placeholderGradients.web;
const delay = index * 0.08;
---

<a
  href={`/blog/${post.id}`}
  class="blog-card group block"
  style={`--cat-color: ${catColor}; --delay: ${delay}s`}
>
  <div class="blog-card__inner">
    {post.data.image ? (
      <div class="blog-card__image-wrap">
        <img
          src={post.data.image}
          alt={post.data.title}
          class="blog-card__image"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="blog-card__placeholder" style={`background: ${placeholderBg}`}>
        <div class="blog-card__placeholder-grid" aria-hidden="true">
          <div class="blog-card__placeholder-dot" style={`background: ${catColor}`}></div>
          <div class="blog-card__placeholder-line" style={`background: ${catColor}`}></div>
          <div class="blog-card__placeholder-dot" style={`background: ${catColor}`}></div>
          <div class="blog-card__placeholder-line" style={`background: ${catColor}`}></div>
        </div>
      </div>
    )}
    <div class="blog-card__body">
      <div class="blog-card__meta">
        <span class="blog-card__category" style={`color: ${catColor}`}>
          <span class="blog-card__category-dot" style={`background: ${catColor}`}></span>
          {categoryLabels[cat] || cat}
        </span>
        <span class="blog-card__date">
          {post.data.pubDate.toLocaleDateString('pt-BR', {
            day: '2-digit',
            month: 'short',
            year: 'numeric'
          })}
        </span>
      </div>
      <h2 class="blog-card__title">{post.data.title}</h2>
      <p class="blog-card__desc">{post.data.description}</p>
      <div class="blog-card__footer">
        <span class="blog-card__reading-time">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {post.data.readingTime || 5} min de leitura
        </span>
        <span class="blog-card__arrow">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </span>
      </div>
    </div>
  </div>
</a>

<style>
  .blog-card {
    --cat-color: #f65e37;
    --delay: 0s;
    text-decoration: none;
    animation: card-in 0.6s ease-out var(--delay) both;
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .blog-card__inner {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                border-color 0.4s ease,
                box-shadow 0.4s ease;
  }

  .blog-card:hover .blog-card__inner {
    transform: translateY(-4px);
    border-color: var(--cat-color);
    box-shadow: 0 12px 40px -8px rgba(0, 0, 0, 0.3),
                0 0 0 1px rgba(var(--cat-color), 0.15);
  }

  .blog-card__image-wrap {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .blog-card:hover .blog-card__image {
    transform: scale(1.05);
  }

  .blog-card__placeholder {
    width: 100%;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .blog-card__placeholder-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    padding: 32px;
    opacity: 0.15;
  }

  .blog-card__placeholder-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    justify-self: center;
  }

  .blog-card__placeholder-line {
    height: 1px;
    align-self: center;
    opacity: 0.5;
  }

  .blog-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 24px;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    gap: 12px;
  }

  .blog-card__category {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: "DM Sans", sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .blog-card__category-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    display: block;
  }

  .blog-card__date {
    font-family: "DM Sans", sans-serif;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.3);
    white-space: nowrap;
  }

  .blog-card__title {
    font-family: "Sora", sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.35;
    color: #fff;
    margin: 0 0 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__desc {
    font-family: "DM Sans", sans-serif;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.45);
    margin: 0 0 16px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .blog-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .blog-card__reading-time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: "DM Sans", sans-serif;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .blog-card__reading-time svg {
    opacity: 0.4;
    flex-shrink: 0;
  }

  .blog-card__arrow {
    color: var(--cat-color);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .blog-card:hover .blog-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .blog-card__inner {
      transition: none;
    }
    .blog-card:hover .blog-card__inner {
      transform: none;
    }
    .blog-card__image {
      transition: none;
    }
    .blog-card:hover .blog-card__image {
      transform: none;
    }
    .blog-card__arrow {
      opacity: 1;
      transform: none;
    }
  }
</style>
