---
const planosSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Planos de Manutenção de TI e Prazos de Projetos em Porto Alegre",
      "description": "Planos mensais de suporte de TI, manutenção preventiva de computadores e cronograma de desenvolvimento web em Porto Alegre.",
      "provider": {
        "@id": "https://sigelinformatica.com.br/#localbusiness"
      },
      "areaServed": [
        { "@type": "City", "name": "Porto Alegre" },
        { "@type": "State", "name": "Rio Grande do Sul" },
        { "@type": "Country", "name": "Brasil" }
      ],
      "serviceType": "Suporte de TI e Desenvolvimento Web"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quais são os planos de manutenção mensal de TI para empresas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Sigel oferece planos mensais corporativos com suporte remoto ilimitado, manutenção preventiva física de computadores e atendimento presencial em Porto Alegre a partir de R$ 97/mês (Starter), R$ 247/mês (Business) e R$ 497/mês (Corporate)."
          }
        },
        {
          "@type": "Question",
          "name": "Como funcionam os prazos de desenvolvimento de sites e projetos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para sites institucionais, o prazo médio é de 15 a 20 dias úteis. Para lojas virtuais e e-commerce, o prazo varia de 30 a 45 dias úteis, com entregas transparentes divididas por fases."
          }
        },
        {
          "@type": "Question",
          "name": "Por que a Sigel limita a capacidade a 8 projetos simultâneos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Limitamos os projetos simultâneos para assegurar suporte individualizado, alta fidelidade de entrega e cumprimento rigoroso dos cronogramas acordados sem sobrecarga."
          }
        },
        {
          "@type": "Question",
          "name": "Vocês atendem presencialmente em Porto Alegre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim! Nosso laboratório fica no Bairro Cristal e realizamos atendimentos presenciais e visitas técnicas em toda a Zona Sul, Centro e região metropolitana de Porto Alegre."
          }
        }
      ]
    }
  ]
});
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const totalVagas = 8;
const filledVagas = 6;
const progressPercent = Math.round((filledVagas / totalVagas) * 100);
const vagasRestantes = totalVagas - filledVagas;
const restamTexto =
    vagasRestantes === 1
        ? `Resta apenas 1 vaga`
        : `Restam apenas ${vagasRestantes} vagas`;

const prazos = [
    {
        name: "Site Institucional",
        icon: "web",
        dias: "15–20 dias",
        href: "/web",
        width: 44,
    },
    {
        name: "E-commerce / Loja Virtual",
        icon: "shopping_cart",
        dias: "30–45 dias",
        href: "/web",
        width: 100,
    },
    {
        name: "Branding Completo",
        icon: "palette",
        dias: "20–25 dias",
        href: null,
        width: 56,
    },
    {
        name: "Automação",
        icon: "settings",
        dias: "10–15 dias",
        href: "/automacao",
        width: 33,
        extra: "& Copy",
    },
    {
        name: "Manutenção de PCs",
        icon: "build",
        dias: "2–5 dias",
        href: null,
        width: 11,
    },
];

const variaveis = [
    {
        icon: "design_services",
        title: "Complexidade do Design",
        desc: "Layouts exclusivos, identidade visual e animações personalizadas exigem mais horas de prancheta e refino.",
    },
    {
        icon: "integration_instructions",
        title: "Integrações Sistêmicas",
        desc: "Conexão com CRM, APIs, meios de pagamento e gatilhos de automação ampliam o escopo técnico do projeto.",
    },
    {
        icon: "rocket_launch",
        title: "Taxa de Urgência",
        desc: "Prazos apertados exigem alocação prioritária da equipe — impactam o cronograma e o investimento.",
    },
];
---

<Base
    title="Planos de Manutenção de TI e Prazos de Projetos | Sigel"
    description="Conheça os planos de suporte e manutenção de TI para empresas em Porto Alegre, além dos prazos de desenvolvimento web e capacidade da Sigel."
    canonical="/planos"
    breadcrumbs={[{ name: "Planos e Prazos", path: "/planos" }]}
    schema={planosSchema}
    bodyClass="has-mobile-cta"
>
    <Header />

    <main class="w-full px-5 md:px-12 pt-8 md:pt-16 pb-12 md:pb-24">
        <div class="max-w-7xl mx-auto flex flex-col gap-12 md:gap-16">
            {/* ===== HERO COMPACTO ===== */}
            <section class="flex flex-col gap-3">
                <nav
                    class="flex items-center gap-2 text-sm text-gray-500 mb-4 md:mb-6 font-medium"
                >
                    <a href="/" class="hover:text-white transition-colors"
                        >Home</a
                    >
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="opacity-40"
                        ><polyline points="9 18 15 12 9 6"></polyline></svg
                    >
                    <span class="text-gray-400">Planos</span>
                </nav>
                <h1
                    class="text-3xl md:text-5xl lg:text-6xl text-white font-black leading-[1.1] tracking-tight"
                >
                    Planos <span class="text-primary">e Prazos</span>
                </h1>
                <p
                    class="text-gray-400 text-base md:text-lg leading-relaxed max-w-2xl"
                >
                    Transparência em cada etapa. Veja nossa capacidade atual,
                    prazos estimados por tipo de projeto e o que define o
                    investimento.
                </p>
            </section>

            
            {/* ===== SELEÇÃO DE PLANOS & SERVIÇOS (ROTEAMENTO B2B) ===== */}
            <section class="flex flex-col gap-6">
                <div class="flex flex-col gap-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-primary">Soluções Corporativas</span>
                    <h2 class="text-2xl md:text-4xl font-bold tracking-tight text-white">
                        O que sua empresa precisa hoje?
                    </h2>
                    <p class="text-gray-400 text-sm md:text-base max-w-2xl">
                        Seja para terceirização e suporte contínuo de informática ou para criar um novo site de alta conversão, temos o modelo ideal.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {/* Card 1: Contratos de TI */}
                    <div class="group relative flex flex-col justify-between p-6 md:p-8 rounded-2xl border border-primary/30 bg-surface-dark hover:border-primary transition-all duration-300">
                        <div class="flex flex-col gap-4">
                            <div class="flex items-center justify-between">
                                <span class="px-3 py-1 text-xs font-bold rounded-lg bg-primary/15 text-primary uppercase tracking-wider">
                                    Suporte Recorrente • A partir de R$ 97/mês
                                </span>
                                <span class="material-symbols-outlined text-primary text-2xl">support_agent</span>
                            </div>
                            <h3 class="text-xl md:text-2xl font-bold text-white tracking-tight">
                                Planos de Manutenção e Suporte de TI
                            </h3>
                            <p class="text-gray-400 text-sm leading-relaxed">
                                Terceirização completa de informática para escritórios, clínicas e empresas em Porto Alegre. Help desk remoto, manutenção preventiva física e visitas no local sem custos surpresa.
                            </p>
                            <ul class="flex flex-col gap-2 text-sm text-gray-300 my-2">
                                <li class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-base">check_circle</span>
                                    <span>Planos Starter (R$ 97), Business (R$ 247) e Corporate (R$ 497)</span>
                                </li>
                                <li class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-base">check_circle</span>
                                    <span>Atendimento remoto rápido e preventivo presencial</span>
                                </li>
                                <li class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-base">check_circle</span>
                                    <span>Cancelamento sem multa a qualquer momento</span>
                                </li>
                            </ul>
                        </div>
                        <a
                            href="/contratos"
                            class="mt-4 inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl font-bold text-sm md:text-base text-white transition-all bg-primary hover:bg-primary-dark"
                        >
                            <span>Ver Planos de Contrato Mensal</span>
                            <span class="material-symbols-outlined text-lg">arrow_forward</span>
                        </a>
                    </div>

                    {/* Card 2: Criação de Sites */}
                    <div class="group relative flex flex-col justify-between p-6 md:p-8 rounded-2xl border border-gray-800 bg-surface-dark hover:border-primary/40 transition-all duration-300">
                        <div class="flex flex-col gap-4">
                            <div class="flex items-center justify-between">
                                <span class="px-3 py-1 text-xs font-bold rounded-lg bg-white/10 text-gray-300 uppercase tracking-wider">
                                    Projetos Sob Medida
                                </span>
                                <span class="material-symbols-outlined text-primary text-2xl">laptop_mac</span>
                            </div>
                            <h3 class="text-xl md:text-2xl font-bold text-white tracking-tight">
                                Criação de Sites e Desenvolvimento Web
                            </h3>
                            <p class="text-gray-400 text-sm leading-relaxed">
                                Websites e landing pages ultra rápidos desenvolvidos em arquitetura moderna para empresas que buscam posicionamento no topo do Google e conversão de leads 24/7.
                            </p>
                            <ul class="flex flex-col gap-2 text-sm text-gray-300 my-2">
                                <li class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-base">check_circle</span>
                                    <span>Prazos médios transparentes de 15 a 20 dias úteis</span>
                                </li>
                                <li class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-base">check_circle</span>
                                    <span>Design exclusivo, ultra rápido e com SEO local nativo</span>
                                </li>
                                <li class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-base">check_circle</span>
                                    <span>Acompanhamento da capacidade de vagas abaixo</span>
                                </li>
                            </ul>
                        </div>
                        <a
                            href="/web"
                            class="mt-4 inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl font-bold text-sm md:text-base text-white transition-all border border-gray-700 hover:border-primary hover:text-primary"
                        >
                            <span>Conhecer Criação de Sites</span>
                            <span class="material-symbols-outlined text-lg">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </section>

            {/* ===== CAPACITY DASHBOARD (herói de dados) ===== */}
            <section
                class="relative overflow-hidden rounded-[2rem] border border-primary/20 p-8 md:p-10"
                style="background: linear-gradient(135deg, #141110 0%, #1a1512 100%);"
            >
                <div
                    class="absolute -top-20 -right-20 w-64 h-64 rounded-full opacity-20 pointer-events-none"
                    style="background: radial-gradient(circle, #f65e37 0%, transparent 70%);"
                >
                </div>
                <div
                    class="absolute -bottom-20 -left-20 w-48 h-48 rounded-full opacity-10 pointer-events-none"
                    style="background: radial-gradient(circle, #f65e37 0%, transparent 70%);"
                >
                </div>

                <div
                    class="relative z-10 flex flex-col md:flex-row md:items-center gap-6 md:gap-12"
                >
                    <div class="flex-1">
                        <div class="flex items-center gap-2 mb-4">
                            <span
                                class="flex h-2.5 w-2.5 rounded-full bg-primary animate-pulse"
                            ></span>
                            <span
                                class="text-xs font-bold uppercase tracking-widest text-primary"
                                >Status: Alta Demanda</span
                            >
                        </div>

                        <h2
                            class="text-2xl md:text-3xl font-black text-white mb-2 tracking-tight"
                        >
                            Capacidade de Operação
                        </h2>
                        <p
                            class="text-gray-400 text-sm md:text-base leading-relaxed max-w-lg"
                        >
                            Limitamos a <strong class="text-white"
                                >8 projetos simultâneos</strong
                            > para garantir performance e suporte individualizado
                            a cada cliente.
                        </p>
                    </div>

                    <div class="shrink-0 text-right">
                        <div class="flex items-baseline justify-end gap-2">
                            <span
                                class="text-5xl md:text-6xl font-black text-white tracking-tight"
                                >{progressPercent}%</span
                            >
                        </div>
                        <p class="text-gray-500 text-xs md:text-sm font-medium">
                            {filledVagas} de {totalVagas} projetos em curso
                        </p>
                    </div>
                </div>

                <div class="relative z-10 mt-8 space-y-3">
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500 font-medium"
                            >Ocupação Atual</span
                        >
                        <span
                            class="text-primary font-bold animate-bounce text-xs md:text-sm"
                            >{restamTexto}</span
                        >
                    </div>

                    <div
                        class="w-full bg-black/60 rounded-full h-10 overflow-hidden shadow-[inset_0_2px_4px_rgba(0,0,0,0.5)] relative border border-white/5"
                    >
                        <div
                            class="bg-primary h-full rounded-full relative overflow-hidden transition-all duration-1000 ease-out shadow-[0_0_30px_rgba(246,94,55,0.3)]"
                            style={`width: ${progressPercent}%`}
                        >
                            <div
                                class="absolute inset-0 w-full h-full animate-shimmer"
                                style="background-image: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent); background-size: 200% 100%;"
                            >
                            </div>
                        </div>
                    </div>

                    <div class="flex justify-between items-center">
                        <p
                            class="text-[11px] md:text-[13px] text-gray-500 italic"
                        >
                            *Atualizado conforme roadmap da equipe.
                        </p>
                        <a
                            href="https://wa.me/555193257923?text=Ol%C3%A1%21%20Estava%20no%20site%20da%20Sigel%20e%20gostaria%20de%20solicitar%20um%20diagn%C3%B3stico%20gratuito%20para%20o%20meu%20neg%C3%B3cio."
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 text-sm font-bold text-primary hover:text-white transition-colors"
                        >
                            <span>Reserve sua vaga</span>
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><line x1="5" y1="12" x2="19" y2="12"
                                ></line><polyline points="12 5 19 12 12 19"
                                ></polyline></svg
                            >
                        </a>
                    </div>
                </div>
            </section>

            {/* ===== PRAZOS (barras horizontais proporcionais) ===== */}
            <section class="flex flex-col gap-6">
                <div class="flex items-center justify-between">
                    <h2
                        class="text-2xl md:text-3xl font-bold tracking-tight text-white"
                    >
                        Prazos Estimados
                    </h2>
                    <span
                        class="text-xs font-bold px-3 py-1.5 bg-primary/15 text-primary rounded-lg uppercase tracking-wider hidden sm:block"
                        >Baseado em histórico</span
                    >
                </div>

                <div class="flex flex-col gap-3">
                    {
                        prazos.map((item) => (
                            <div class="group flex items-center gap-4 p-4 md:p-5 rounded-2xl bg-surface-dark border border-gray-800 hover:border-gray-700 transition-all">
                                <div class="shrink-0 size-10 md:size-12 rounded-xl bg-black/40 flex items-center justify-center text-gray-400 group-hover:text-primary transition-colors">
                                    <span class="material-symbols-outlined text-xl md:text-2xl">
                                        {item.icon}
                                    </span>
                                </div>

                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between mb-2">
                                        <div class="flex items-center gap-1.5 flex-wrap">
                                            {item.href ? (
                                                <a
                                                    href={item.href}
                                                    class="font-bold text-white text-sm md:text-base hover:text-primary transition-colors"
                                                >
                                                    {item.name}
                                                </a>
                                            ) : (
                                                <span class="font-bold text-white text-sm md:text-base">
                                                    {item.name}
                                                </span>
                                            )}
                                            {item.extra && (
                                                <span class="text-gray-500 text-sm md:text-base font-medium">
                                                    {item.extra}
                                                </span>
                                            )}
                                        </div>
                                        <span class="shrink-0 text-sm md:text-base font-black text-primary ml-2">
                                            {item.dias}
                                        </span>
                                    </div>

                                    <div class="w-full bg-black/40 rounded-full h-2.5 overflow-hidden">
                                        <div
                                            class="bg-primary/80 h-full rounded-full transition-all duration-700 group-hover:bg-primary"
                                            style={`width: ${item.width}%`}
                                        />
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            {/* ===== VARIÁVEIS (3 cards horizontais) ===== */}
            <section class="flex flex-col gap-6">
                <h2
                    class="text-2xl md:text-3xl font-bold tracking-tight text-white"
                >
                    O que define o investimento?
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
                    {
                        variaveis.map((card) => (
                            <div class="group relative p-6 md:p-8 rounded-2xl border border-gray-800 bg-surface-dark transition-all duration-500 hover:border-primary/30">
                                <div class="relative z-10">
                                    <div class="shrink-0 size-12 md:size-14 rounded-xl bg-primary/10 flex items-center justify-center text-primary mb-5 transition-all duration-500 group-hover:scale-110 group-hover:bg-primary/20">
                                        <span class="material-symbols-outlined text-2xl md:text-3xl">
                                            {card.icon}
                                        </span>
                                    </div>
                                    <h3 class="font-bold text-lg text-white mb-2 tracking-tight">
                                        {card.title}
                                    </h3>
                                    <p class="text-gray-400 text-sm leading-relaxed">
                                        {card.desc}
                                    </p>
                                </div>
                                <div
                                    class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                                    style="background: radial-gradient(ellipse at 50% 0%, rgba(246,94,55,0.04) 0%, transparent 70%)"
                                />
                            </div>
                        ))
                    }
                </div>
            </section>

                        {/* ===== FAQ SECTION ===== */}
            <section class="flex flex-col gap-6">
                <div class="text-left md:text-center max-w-2xl md:mx-auto">
                    <span class="text-xs font-bold uppercase tracking-wider text-primary">Tire suas Dúvidas</span>
                    <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight mt-1">
                        Dúvidas Frequentes sobre Planos e Prazos
                    </h2>
                    <p class="text-gray-400 text-sm md:text-base mt-2">
                        Perguntas frequentes sobre suporte corporativo de TI e cronograma de projetos.
                    </p>
                </div>

                <div class="flex flex-col gap-4 max-w-4xl mx-auto w-full">
                    <details class="group bg-surface-dark rounded-2xl overflow-hidden border border-gray-800 shadow-sm transition-all duration-300">
                        <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-5 md:p-6 text-white text-base md:text-lg hover:bg-white/5 transition-colors">
                            <span>Quais são os planos de manutenção mensal de TI para empresas?</span>
                            <span class="material-symbols-outlined text-primary transition-transform duration-300 group-open:rotate-180">expand_more</span>
                        </summary>
                        <div class="px-5 pb-5 md:px-6 md:pb-6 text-gray-300 text-sm md:text-base leading-relaxed border-t border-gray-800/60 pt-4">
                            A Sigel oferece planos mensais corporativos com suporte remoto ilimitado, manutenção preventiva física periódica e atendimento presencial em Porto Alegre. Os planos iniciam em R$ 97/mês (Starter), R$ 247/mês (Business) e R$ 497/mês (Corporate). Veja detalhes completos na nossa página de <a href="/contratos" class="text-primary hover:underline font-semibold">contratos de manutenção de TI</a>.
                        </div>
                    </details>

                    <details class="group bg-surface-dark rounded-2xl overflow-hidden border border-gray-800 shadow-sm transition-all duration-300">
                        <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-5 md:p-6 text-white text-base md:text-lg hover:bg-white/5 transition-colors">
                            <span>Como funcionam os prazos de desenvolvimento de sites e projetos?</span>
                            <span class="material-symbols-outlined text-primary transition-transform duration-300 group-open:rotate-180">expand_more</span>
                        </summary>
                        <div class="px-5 pb-5 md:px-6 md:pb-6 text-gray-300 text-sm md:text-base leading-relaxed border-t border-gray-800/60 pt-4">
                            Para sites institucionais, o prazo médio é de 15 a 20 dias úteis. Para lojas virtuais e e-commerce, varia de 30 a 45 dias úteis. O cronograma é dividido em fases transparentes com acompanhamento direto da entrega. Conheça nosso método na página de <a href="/web" class="text-primary hover:underline font-semibold">criação de sites em Porto Alegre</a>.
                        </div>
                    </details>

                    <details class="group bg-surface-dark rounded-2xl overflow-hidden border border-gray-800 shadow-sm transition-all duration-300">
                        <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-5 md:p-6 text-white text-base md:text-lg hover:bg-white/5 transition-colors">
                            <span>Por que a Sigel limita a capacidade a 8 projetos simultâneos?</span>
                            <span class="material-symbols-outlined text-primary transition-transform duration-300 group-open:rotate-180">expand_more</span>
                        </summary>
                        <div class="px-5 pb-5 md:px-6 md:pb-6 text-gray-300 text-sm md:text-base leading-relaxed border-t border-gray-800/60 pt-4">
                            Limitamos o volume de projetos simultâneos para garantir suporte individualizado e cumprimento rigoroso das datas de entrega, assegurando máxima qualidade técnica para cada cliente atendido.
                        </div>
                    </details>

                    <details class="group bg-surface-dark rounded-2xl overflow-hidden border border-gray-800 shadow-sm transition-all duration-300">
                        <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-5 md:p-6 text-white text-base md:text-lg hover:bg-white/5 transition-colors">
                            <span>Vocês atendem presencialmente em Porto Alegre?</span>
                            <span class="material-symbols-outlined text-primary transition-transform duration-300 group-open:rotate-180">expand_more</span>
                        </summary>
                        <div class="px-5 pb-5 md:px-6 md:pb-6 text-gray-300 text-sm md:text-base leading-relaxed border-t border-gray-800/60 pt-4">
                            Sim! Nosso laboratório físico fica localizado na Av. Icaraí, 1428 (Bairro Cristal). Realizamos atendimentos presenciais, coletas e suporte in loco em toda Porto Alegre e região metropolitana.
                        </div>
                    </details>
                </div>
