---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const totalVagas = 8;
const filledVagas = 6;
const progressPercent = Math.round((filledVagas / totalVagas) * 100);
const vagasRestantes = totalVagas - filledVagas;
const restamTexto =
    vagasRestantes === 1
        ? `Resta apenas 1 vaga`
        : `Restam apenas ${vagasRestantes} vagas`;

const prazos = [
    {
        name: "Site Institucional",
        icon: "web",
        dias: "15–20 dias",
        href: "/web",
        width: 44,
    },
    {
        name: "E-commerce / Loja Virtual",
        icon: "shopping_cart",
        dias: "30–45 dias",
        href: "/web",
        width: 100,
    },
    {
        name: "Branding Completo",
        icon: "palette",
        dias: "20–25 dias",
        href: null,
        width: 56,
    },
    {
        name: "Automação",
        icon: "settings",
        dias: "10–15 dias",
        href: "/automacao",
        width: 33,
        extra: "& Copy",
    },
    {
        name: "Manutenção de PCs",
        icon: "build",
        dias: "2–5 dias",
        href: null,
        width: 11,
    },
];

const variaveis = [
    {
        icon: "design_services",
        title: "Complexidade do Design",
        desc: "Layouts exclusivos, identidade visual e animações personalizadas exigem mais horas de prancheta e refino.",
    },
    {
        icon: "integration_instructions",
        title: "Integrações Sistêmicas",
        desc: "Conexão com CRM, APIs, meios de pagamento e gatilhos de automação ampliam o escopo técnico do projeto.",
    },
    {
        icon: "rocket_launch",
        title: "Taxa de Urgência",
        desc: "Prazos apertados exigem alocação prioritária da equipe — impactam o cronograma e o investimento.",
    },
];
---

<Base
    title="Planos - Sigel | Prazos, Capacidade e Orçamentos"
    description="Veja prazos estimados, a capacidade atual de operação da Sigel e o que define o investimento do seu projeto. Transparência total."
    canonical="/planos"
    breadcrumbs={[{ name: "Planos", path: "/planos" }]}
    bodyClass="has-mobile-cta"
>
    <Header />

    <main class="w-full px-5 md:px-12 pt-8 md:pt-16 pb-12 md:pb-24">
        <div class="max-w-7xl mx-auto flex flex-col gap-12 md:gap-16">
            {/* ===== HERO COMPACTO ===== */}
            <section class="flex flex-col gap-3">
                <nav
                    class="flex items-center gap-2 text-sm text-gray-500 mb-4 md:mb-6 font-medium"
                >
                    <a href="/" class="hover:text-white transition-colors"
                        >Home</a
                    >
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="opacity-40"
                        ><polyline points="9 18 15 12 9 6"></polyline></svg
                    >
                    <span class="text-gray-400">Planos</span>
                </nav>
                <h1
                    class="text-3xl md:text-5xl lg:text-6xl text-white font-black leading-[1.1] tracking-tight"
                >
                    Planos <span class="text-primary">e Prazos</span>
                </h1>
                <p
                    class="text-gray-400 text-base md:text-lg leading-relaxed max-w-2xl"
                >
                    Transparência em cada etapa. Veja nossa capacidade atual,
                    prazos estimados por tipo de projeto e o que define o
                    investimento.
                </p>
            </section>

            {/* ===== CAPACITY DASHBOARD (herói de dados) ===== */}
            <section
                class="relative overflow-hidden rounded-[2rem] border border-primary/20 p-8 md:p-10"
                style="background: linear-gradient(135deg, #141110 0%, #1a1512 100%);"
            >
                <div
                    class="absolute -top-20 -right-20 w-64 h-64 rounded-full opacity-20 pointer-events-none"
                    style="background: radial-gradient(circle, #f65e37 0%, transparent 70%);"
                >
                </div>
                <div
                    class="absolute -bottom-20 -left-20 w-48 h-48 rounded-full opacity-10 pointer-events-none"
                    style="background: radial-gradient(circle, #f65e37 0%, transparent 70%);"
                >
                </div>

                <div
                    class="relative z-10 flex flex-col md:flex-row md:items-center gap-6 md:gap-12"
                >
                    <div class="flex-1">
                        <div class="flex items-center gap-2 mb-4">
                            <span
                                class="flex h-2.5 w-2.5 rounded-full bg-primary animate-pulse"
                            ></span>
                            <span
                                class="text-xs font-bold uppercase tracking-widest text-primary"
                                >Status: Alta Demanda</span
                            >
                        </div>

                        <h2
                            class="text-2xl md:text-3xl font-black text-white mb-2 tracking-tight"
                        >
                            Capacidade de Operação
                        </h2>
                        <p
                            class="text-gray-400 text-sm md:text-base leading-relaxed max-w-lg"
                        >
                            Limitamos a <strong class="text-white"
                                >8 projetos simultâneos</strong
                            > para garantir performance e suporte individualizado
                            a cada cliente.
                        </p>
                    </div>

                    <div class="shrink-0 text-right">
                        <div class="flex items-baseline justify-end gap-2">
                            <span
                                class="text-5xl md:text-6xl font-black text-white tracking-tight"
                                >{progressPercent}%</span
                            >
                        </div>
                        <p class="text-gray-500 text-xs md:text-sm font-medium">
                            {filledVagas} de {totalVagas} projetos em curso
                        </p>
                    </div>
                </div>

                <div class="relative z-10 mt-8 space-y-3">
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500 font-medium"
                            >Ocupação Atual</span
                        >
                        <span
                            class="text-primary font-bold animate-bounce text-xs md:text-sm"
                            >{restamTexto}</span
                        >
                    </div>

                    <div
                        class="w-full bg-black/60 rounded-full h-10 overflow-hidden shadow-[inset_0_2px_4px_rgba(0,0,0,0.5)] relative border border-white/5"
                    >
                        <div
                            class="bg-primary h-full rounded-full relative overflow-hidden transition-all duration-1000 ease-out shadow-[0_0_30px_rgba(246,94,55,0.3)]"
                            style={`width: ${progressPercent}%`}
                        >
                            <div
                                class="absolute inset-0 w-full h-full animate-shimmer"
                                style="background-image: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent); background-size: 200% 100%;"
                            >
                            </div>
                        </div>
                    </div>

                    <div class="flex justify-between items-center">
                        <p
                            class="text-[11px] md:text-[13px] text-gray-500 italic"
                        >
                            *Atualizado conforme roadmap da equipe.
                        </p>
                        <a
                            href="https://wa.me/555193257923?text=Ol%C3%A1%21%20Estava%20no%20site%20da%20Sigel%20e%20gostaria%20de%20solicitar%20um%20diagn%C3%B3stico%20gratuito%20para%20o%20meu%20neg%C3%B3cio."
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 text-sm font-bold text-primary hover:text-white transition-colors"
                        >
                            <span>Reserve sua vaga</span>
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><line x1="5" y1="12" x2="19" y2="12"
                                ></line><polyline points="12 5 19 12 12 19"
                                ></polyline></svg
                            >
                        </a>
                    </div>
                </div>
            </section>

            {/* ===== PRAZOS (barras horizontais proporcionais) ===== */}
            <section class="flex flex-col gap-6">
                <div class="flex items-center justify-between">
                    <h2
                        class="text-2xl md:text-3xl font-bold tracking-tight text-white"
                    >
                        Prazos Estimados
                    </h2>
                    <span
                        class="text-xs font-bold px-3 py-1.5 bg-primary/15 text-primary rounded-lg uppercase tracking-wider hidden sm:block"
                        >Baseado em histórico</span
                    >
                </div>

                <div class="flex flex-col gap-3">
                    {
                        prazos.map((item) => (
                            <div class="group flex items-center gap-4 p-4 md:p-5 rounded-2xl bg-surface-dark border border-gray-800 hover:border-gray-700 transition-all">
                                <div class="shrink-0 size-10 md:size-12 rounded-xl bg-black/40 flex items-center justify-center text-gray-400 group-hover:text-primary transition-colors">
                                    <span class="material-symbols-outlined text-xl md:text-2xl">
                                        {item.icon}
                                    </span>
                                </div>

                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between mb-2">
                                        <div class="flex items-center gap-1.5 flex-wrap">
                                            {item.href ? (
                                                <a
                                                    href={item.href}
                                                    class="font-bold text-white text-sm md:text-base hover:text-primary transition-colors"
                                                >
                                                    {item.name}
                                                </a>
                                            ) : (
                                                <span class="font-bold text-white text-sm md:text-base">
                                                    {item.name}
                                                </span>
                                            )}
                                            {item.extra && (
                                                <span class="text-gray-500 text-sm md:text-base font-medium">
                                                    {item.extra}
                                                </span>
                                            )}
                                        </div>
                                        <span class="shrink-0 text-sm md:text-base font-black text-primary ml-2">
                                            {item.dias}
                                        </span>
                                    </div>

                                    <div class="w-full bg-black/40 rounded-full h-2.5 overflow-hidden">
                                        <div
                                            class="bg-primary/80 h-full rounded-full transition-all duration-700 group-hover:bg-primary"
                                            style={`width: ${item.width}%`}
                                        />
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            {/* ===== VARIÁVEIS (3 cards horizontais) ===== */}
            <section class="flex flex-col gap-6">
                <h2
                    class="text-2xl md:text-3xl font-bold tracking-tight text-white"
                >
                    O que define o investimento?
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
                    {
                        variaveis.map((card) => (
                            <div class="group relative p-6 md:p-8 rounded-2xl border border-gray-800 bg-surface-dark transition-all duration-500 hover:border-primary/30">
                                <div class="relative z-10">
                                    <div class="shrink-0 size-12 md:size-14 rounded-xl bg-primary/10 flex items-center justify-center text-primary mb-5 transition-all duration-500 group-hover:scale-110 group-hover:bg-primary/20">
                                        <span class="material-symbols-outlined text-2xl md:text-3xl">
                                            {card.icon}
                                        </span>
                                    </div>
                                    <h3 class="font-bold text-lg text-white mb-2 tracking-tight">
                                        {card.title}
                                    </h3>
                                    <p class="text-gray-400 text-sm leading-relaxed">
                                        {card.desc}
                                    </p>
                                </div>
                                <div
                                    class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                                    style="background: radial-gradient(ellipse at 50% 0%, rgba(246,94,55,0.04) 0%, transparent 70%)"
                                />
                            </div>
                        ))
                    }
                </div>
            </section>

            {/* ===== CTA DESKTOP ===== */}
            <section class="hidden md:block">
                <div
                    class="relative rounded-[2rem] overflow-hidden p-8 md:p-14"
                    style="background: linear-gradient(135deg, #141110 0%, #1a1512 100%);"
                >
                    <div
                        class="absolute top-0 right-0 w-80 h-80 rounded-full opacity-10 pointer-events-none"
                        style="background: radial-gradient(circle, #f65e37 0%, transparent 70%);"
                    >
                    </div>
                    <div
                        class="absolute bottom-0 left-0 w-64 h-64 rounded-full opacity-10 pointer-events-none"
                        style="background: radial-gradient(circle, #f65e37 0%, transparent 70%);"
                    >
                    </div>

                    <div
                        class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8 md:gap-16"
                    >
                        <div class="flex flex-col gap-3 max-w-xl">
                            <h3
                                class="text-3xl md:text-4xl text-white font-black tracking-tight leading-tight"
                            >
                                Reserve seu espaço na agenda
                            </h3>
                            <p
                                class="text-gray-400 text-base md:text-lg leading-relaxed"
                            >
                                Sem compromisso! Agende um diagnóstico rápido
                                para entender o melhor caminho para começarmos a
                                crescer juntos.
                            </p>
                        </div>

                        <a
                            href="https://wa.me/555193257923?text=Ol%C3%A1%21%20Estava%20no%20site%20da%20Sigel%20e%20gostaria%20de%20solicitar%20um%20diagn%C3%B3stico%20gratuito%20para%20o%20meu%20neg%C3%B3cio."
                            target="_blank"
                            rel="noopener noreferrer"
                            class="shrink-0 inline-flex items-center justify-center gap-3 py-4 px-8 md:px-10 rounded-xl font-bold text-base md:text-lg text-white transition-all hover:scale-105 active:scale-95 shadow-lg shadow-primary/20"
                            style="background: linear-gradient(135deg, #f65e37, #d54e2b);"
                        >
                            <span class="material-symbols-outlined text-[24px]"
                                >calendar_today</span
                            >
                            <span>Ver Disponibilidade</span>
                        </a>
                    </div>
                </div>
            </section>
        </div>
    </main>

    {/* ===== STICKY MOBILE CTA BAR ===== */}
    <div
        class="md:hidden fixed bottom-0 left-0 right-0 p-4 bg-black/95 backdrop-blur-md border-t border-gray-900 z-50 shadow-[0_-10px_30px_rgba(0,0,0,0.5)]"
    >
        <div class="w-full flex flex-col gap-2 relative">
            <a
                href="https://wa.me/555193257923?text=Ol%C3%A1%21%20Estava%20no%20site%20da%20Sigel%20e%20gostaria%20de%20solicitar%20um%20diagn%C3%B3stico%20gratuito%20para%20o%20meu%20neg%C3%B3cio."
                target="_blank"
                rel="noopener noreferrer"
                class="w-full bg-accent hover:bg-accent-dark text-white font-bold text-lg h-14 rounded-xl shadow-lg shadow-primary/25 active:scale-[0.98] transition-all flex items-center justify-center gap-2"
            >
                <span>Ver disponibilidade</span>
                <span class="material-symbols-outlined text-[20px]"
                    >calendar_today</span
                >
            </a>
            <p
                class="text-[11px] text-center text-gray-400 font-medium tracking-wide"
            >
                Sem compromisso. Apenas checagem de agenda.
            </p>
        </div>
    </div>

    {/* Shimmer Animation */}
    <style>
        @keyframes shimmer {
            0% {
                transform: translateX(-100%) skewX(-12deg);
            }
            100% {
                transform: translateX(200%) skewX(-12deg);
            }
        }

        .animate-shimmer {
            animation: shimmer 2s infinite;
        }
    </style>

    <Footer />
</Base>
