---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.tsx";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  return [
    {
      params: { cidade: 'porto-alegre' },
      props: {
        nome: 'Porto Alegre',
        estado: 'RS',
        title: 'Sigel | Criação de Sites e Suporte de TI em Porto Alegre',
        description: 'Especialistas em desenvolvimento de sites, sistemas, automação e manutenção de computadores em Porto Alegre. Atendimento ágil e presencial/remoto.',
        palavraChave: 'Desenvolvimento Web e TI em Porto Alegre',
        // Imagem representativa de POA
        imagemDestaque: 'https://images.unsplash.com/photo-1626241772922-383794dc2dd1?auto=format&fit=crop&w=800&q=80',
        marcos: ['Usina do Gasômetro', 'Parque Farroupilha (Redenção)', 'Mercado Público']
      }
    }
  ];
}

const { nome, estado, title, description, palavraChave, imagemDestaque, marcos } = Astro.props;
const { cidade } = Astro.params;

const localPageSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "about": {
    "@type": "Place",
    "name": `${nome}, ${estado}`
  }
});
---
<Base 
  title={title} 
  description={description} 
  canonical={`/locais/${cidade}`}
  schema={localPageSchema}
  breadcrumbs={[{ name: nome, path: `/locais/${cidade}` }]}
>
  <Header client:load />

  <section class="relative px-5 md:px-12 pt-32 pb-16 md:pt-40 md:pb-24 w-full bg-[#050505] overflow-hidden min-h-screen flex items-center">
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-30"></div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary/20 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/3"></div>

    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-12 lg:gap-20 relative z-10 w-full">
      {/* Texto */}
      <div class="w-full lg:w-1/2 flex flex-col gap-6">
        <div class="inline-flex items-center gap-2 bg-white/10 px-3 py-1.5 rounded-full w-fit">
          <span class="material-symbols-outlined text-[16px] text-primary">location_on</span>
          <span class="text-xs md:text-sm font-semibold text-gray-300 uppercase tracking-wide">
            Atendimento em {nome}
          </span>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white leading-[1.1] tracking-tight">
          A Sua Agência de <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">{palavraChave}</span>
        </h1>
        
        <p class="text-gray-400 text-lg leading-relaxed mt-2">
          Sediada e operando no coração de <strong>{nome}, {estado}</strong>, a Sigel entende profundamente as necessidades das empresas locais. Desde negócios próximos ao <strong>{marcos[2]}</strong> até empresas vizinhas à <strong>{marcos[0]}</strong>, entregamos sites rápidos, sistemas web eficientes e manutenção de TI de altíssima confiança.
        </p>

        <div class="mt-4 bg-white/5 border border-white/10 p-5 rounded-2xl">
          <h3 class="text-white font-bold mb-2 flex items-center gap-2">
            <span class="material-symbols-outlined text-green-500">verified</span>
            Vantagem Local
          </h3>
          <p class="text-gray-400 text-sm">
            Conhecemos o mercado da capital gaúcha. Nossas estratégias de SEO e design são calibradas para fazer a sua empresa dominar as buscas locais em {nome} e converter clientes qualificados.
          </p>
        </div>

        <div class="mt-6 flex flex-col sm:flex-row gap-4">
          <a href="https://wa.me/555191305583?text=Ol%C3%A1%21%20Sou%20de%20Porto%20Alegre%20e%20gostaria%20de%20um%20diagn%C3%B3stico%20para%20minha%20empresa." target="_blank" class="flex items-center justify-center gap-2 bg-accent hover:bg-accent-dark text-white font-bold h-14 px-8 rounded-xl transition-all hover:scale-105 active:scale-95 shadow-lg shadow-primary/20">
            <span class="material-symbols-outlined">chat</span>
            <span>Agendar Diagnóstico Gratuito</span>
          </a>
        </div>
      </div>

      {/* Imagem */}
      <div class="w-full lg:w-1/2">
        <div class="rounded-[2.5rem] overflow-hidden border border-white/10 aspect-[4/3] shadow-2xl relative group">
          <img src={imagemDestaque} alt={`Vista de ${nome}`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex flex-col justify-end p-8 md:p-10">
            <div class="flex items-center gap-3 mb-2">
              <span class="w-12 h-1 bg-primary rounded-full"></span>
              <p class="text-white font-bold text-xl md:text-2xl tracking-tight">Especialistas em {nome}</p>
            </div>
            <p class="text-gray-300 text-sm md:text-base">Dominando a tecnologia para os negócios da nossa cidade.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>
