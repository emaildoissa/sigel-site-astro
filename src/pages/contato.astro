---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.tsx";
import Footer from "../components/Footer.astro";

const contactSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contato Sigel | Criação de Sites e Manutenção de TI em Porto Alegre",
  "description": "Entre em contato com a Sigel Soluções em Informática para criação de sites, programas e manutenção em Porto Alegre, RS."
});
---

<Base
  title="Contato Sigel | Criação de Sites e Manutenção de TI em Porto Alegre"
  description="Entre em contato com a Sigel Soluções em Informática para criação de sites, programas e manutenção em Porto Alegre, RS."
  canonical="/contato"
  breadcrumbs={[{ name: "Contato", path: "/contato" }]}
  schema={contactSchema}
>
  <Header client:idle />

  <section class="relative px-5 md:px-12 pt-32 pb-16 md:pt-40 md:pb-24 w-full bg-[#050505] overflow-hidden min-h-[70vh] flex items-center">
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-20"></div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary/10 rounded-full blur-[100px] -translate-y-1/2 translate-x-1/3"></div>
    
    <div class="max-w-7xl mx-auto w-full relative z-10 flex flex-col md:flex-row gap-12 md:gap-24">
      {/* Left Content */}
      <div class="w-full md:w-1/2 flex flex-col gap-6">
        <h1 class="text-4xl md:text-6xl font-black text-white leading-tight tracking-tight">
          Fale com a <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">Sigel</span>
        </h1>
        <p class="text-gray-400 text-lg leading-relaxed">
          Sediados em <strong class="text-white">Porto Alegre, RS</strong>, mas atendendo todo o Brasil. Pronto para escalar suas vendas com um <a href="/web" class="text-primary hover:text-accent transition-colors">novo site</a>, contratar <a href="/copywriting" class="text-primary hover:text-accent transition-colors">copywriting estratégico</a>, <a href="/automacao" class="text-primary hover:text-accent transition-colors">automatizar processos</a> ou garantir a melhor <a href="/servicos" class="text-primary hover:text-accent transition-colors">manutenção de TI</a> para sua empresa?
        </p>

        <div class="mt-8 flex flex-col gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-primary shrink-0">
              <span class="material-symbols-outlined">location_on</span>
            </div>
            <div>
              <h2 class="text-white font-bold text-xl mb-1">Nosso Endereço</h2>
              <p class="text-gray-400">
                Av. Icaraí, 1428 - Cristal<br />
                Porto Alegre - RS, 90810-000<br />
                Brasil
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-primary shrink-0">
              <span class="material-symbols-outlined">call</span>
            </div>
            <div>
              <h2 class="text-white font-bold text-xl mb-1">Telefones (WhatsApp)</h2>
              <a href="https://wa.me/555191305583" target="_blank" rel="noopener noreferrer" class="block text-gray-400 hover:text-white transition-colors">
                (51) 99130-5583
              </a>
              <a href="https://wa.me/555193257923" target="_blank" rel="noopener noreferrer" class="block text-gray-400 hover:text-white transition-colors">
                (51) 99325-7923
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-primary shrink-0">
              <span class="material-symbols-outlined">mail</span>
            </div>
            <div>
              <h2 class="text-white font-bold text-xl mb-1">E-mail</h2>
              <a href="mailto:contato@sigelinformatica.com.br" class="text-gray-400 hover:text-white transition-colors">
                contato@sigelinformatica.com.br
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* Right Content - CTA Card */}
      <div class="w-full md:w-1/2 flex items-center justify-center">
        <div class="bg-surface-dark border border-white/10 p-8 md:p-12 rounded-[2rem] shadow-2xl w-full max-w-md">
          <h2 class="text-2xl font-bold text-white mb-4">Suporte Ágil e Direto</h2>
          <p class="text-gray-400 mb-8">
            Não gostamos de formulários longos. Clique no botão abaixo e fale diretamente com um especialista pelo WhatsApp.
          </p>
          <a
            href="https://wa.me/555191305583?text=Ol%C3%A1%21%20Vim%20pela%20p%C3%A1gina%20de%20contato%20e%20gostaria%20de%20informa%C3%A7%C3%B5es."
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 w-full bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-lg h-16 rounded-xl transition-all hover:scale-105 active:scale-[0.98] shadow-lg shadow-green-500/20"
          >
            <span class="material-symbols-outlined">chat</span>
            <span>Chamar no WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>
