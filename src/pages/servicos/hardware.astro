---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.tsx";
import Footer from "../../components/Footer.astro";
import HardwareServiceCard from "../../components/HardwareServiceCard.astro";

const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Serviços de Hardware e Software em Porto Alegre",
  "description": "Troca de teclado, tela, upgrade SSD, reparo de carcaça, formatação, recuperação de dados e venda de carregadores em Porto Alegre.",
  "provider": { "@type": "LocalBusiness", "name": "Sigel Soluções em Informática", "url": "https://sigelinformatica.com.br" },
  "areaServed": [{ "@type": "City", "name": "Porto Alegre" }, { "@type": "Country", "name": "Brasil" }],
  "serviceType": "Suporte Técnico e Manutenção de Hardware"
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quanto custa trocar a tela do notebook?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "O valor varia conforme o modelo e a disponibilidade de peça. Em média, a troca de tela para notebooks em Porto Alegre fica entre R$ 250 e R$ 800, incluindo mão de obra e garantia."
      }
    },
    {
      "@type": "Question",
      "name": "Quanto tempo leva um upgrade de HDD para SSD?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "O serviço de upgrade para SSD leva em média de 2 a 4 horas, incluindo a migração completa do sistema e dados. O valor do SSD não está incluso — cobramos apenas a mão de obra."
      }
    },
    {
      "@type": "Question",
      "name": "Vocês atendem em domicílio em Porto Alegre?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim, fazemos atendimento presencial em Porto Alegre, especialmente nos bairros Cristal, Tristeza, Menino Deus e Centro. Também oferecemos suporte remoto para toda a região metropolitana."
      }
    },
    {
      "@type": "Question",
      "name": "Quanto custa a formatação de um notebook?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A formatação com instalação limpa do Windows e drivers custa a partir de R$ 120. Inclui backup básico dos dados, otimização e instalação de antivírus."
      }
    },
    {
      "@type": "Question",
      "name": "Vocês vendem carregadores originais?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trabalhamos com carregadores originais e compatíveis de alta qualidade para as principais marcas: Dell, Lenovo, HP, Acer, Samsung e Apple. Valores entre R$ 80 e R$ 250."
      }
    }
  ]
});

const services = [
  {
    icon: "keyboard",
    title: "Troca de Teclado",
    description:
      "Substituição de teclados danificados ou desgastados para notebooks e desktops, garantindo conforto e precisão na digitação.",
  },
  {
    icon: "smart_display",
    title: "Troca de Tela",
    description:
      "Reparo ou substituição de telas quebradas, com peças originais ou de alta qualidade, restaurando a visualização impecável.",
  },
  {
    icon: "storage",
    title: "Upgrade de HDD → SSD",
    description:
      "Migração de discos rígidos para SSDs de alta performance, aumentando velocidade de boot e carregamento de aplicativos.",
  },
  {
    icon: "construction",
    title: "Reparo de Carcaça",
    description:
      "Conserto de danos na estrutura externa do equipamento, como rachaduras, amassados e substituição de partes plásticas.",
  },
  {
    icon: "settings",
    title: "Formatação",
    description:
      "Instalação limpa do sistema operacional, otimização e configuração personalizada para desempenho máximo.",
  },
  {
    icon: "cloud_download",
    title: "Recuperação de Dados",
    description:
      "Recuperação segura de arquivos perdidos ou corrompidos em discos danificados, com alta taxa de sucesso.",
  },
  {
    icon: "charging_station",
    title: "Venda de Carregadores",
    description:
      "Carregadores originais e compatíveis para notebooks, tablets e smartphones, com garantia de qualidade.",
  },
];
---

<Base
  title="Serviços de Hardware e Software em Porto Alegre | Sigel"
  description="Troca de teclado, tela, upgrade SSD, reparo de carcaça, formatação, recuperação de dados e venda de carregadores em Porto Alegre."
  canonical="/servicos/hardware"
  breadcrumbs={[
    { name: "Serviços", path: "/servicos" },
    { name: "Hardware", path: "/servicos/hardware" },
  ]}
  schema={serviceSchema}
>
  <Header client:idle />

  <main class="mx-auto w-full max-w-7xl px-5 md:px-12 pt-10 md:pt-16 pb-16">
    {/* Hero */}
    <section class="mx-auto max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 bg-white/10 px-3 py-1.5 rounded-full w-fit mx-auto mb-6">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-gray-300">Assistência Técnica em Porto Alegre</span>
      </div>

      <h1 class="text-4xl font-black tracking-tight text-white md:text-5xl">
        Serviços de Hardware e Software em <span class="text-primary">Porto Alegre</span>
      </h1>

      <p class="mt-5 text-lg leading-8 text-gray-300">
        Soluções completas de manutenção, upgrade e recuperação para notebooks, desktops e acessórios. Sua empresa também precisa de <a href="/web" class="text-primary hover:text-accent transition-colors">um site profissional</a>? Conheça todos os <a href="/servicos" class="text-primary hover:text-accent transition-colors">nossos serviços</a>.
      </p>

      <div class="mt-8">
        <a
          href="https://wa.me/5551993257923"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3 text-base font-bold text-white shadow-lg transition-all hover:bg-accent-dark hover:scale-[1.02]"
        >
          Solicitar Diagnóstico
          <span class="material-symbols-outlined">arrow_forward</span>
        </a>
      </div>
    </section>

    {/* Stats Strip */}
    <section class="mt-16 bg-surface-dark border border-white/5 rounded-3xl p-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <p class="text-3xl md:text-4xl font-black text-primary mb-1">500+</p>
          <p class="text-sm text-gray-400 font-medium">Notebooks Consertados</p>
        </div>
        <div>
          <p class="text-3xl md:text-4xl font-black text-primary mb-1">98%</p>
          <p class="text-sm text-gray-400 font-medium">Satisfação</p>
        </div>
        <div>
          <p class="text-3xl md:text-4xl font-black text-primary mb-1">30 min</p>
          <p class="text-sm text-gray-400 font-medium">Diagnóstico Rápido</p>
        </div>
        <div>
          <p class="text-3xl md:text-4xl font-black text-primary mb-1">7+</p>
          <p class="text-sm text-gray-400 font-medium">Anos de Experiência</p>
        </div>
      </div>
    </section>

    {/* Services Grid */}
    <section id="servicos" class="mt-16">
      <div class="mb-8 max-w-2xl">
        <h2 class="text-3xl font-bold text-white md:text-4xl">
          Nossos serviços
        </h2>
        <p class="mt-3 text-gray-300">
          Principais soluções para manutenção e melhoria de desempenho do seu equipamento.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        {services.map((s) => (
          <HardwareServiceCard
            icon={s.icon}
            title={s.title}
            description={s.description}
          />
        ))}
      </div>
    </section>

    {/* Process */}
    <section class="mt-20">
      <div class="md:text-center mb-12">
        <h2 class="text-3xl font-bold text-white md:text-4xl mb-3">Como funciona</h2>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto">Processo simples e transparente, do diagnóstico à entrega.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-surface-dark border border-white/10 rounded-2xl p-8 text-center">
          <div class="w-14 h-14 rounded-full bg-primary/20 flex items-center justify-center mx-auto mb-5">
            <span class="material-symbols-outlined text-primary text-3xl">search</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">1. Diagnóstico</h3>
          <p class="text-gray-400 text-sm">Analisamos seu equipamento e informamos o defeito, o prazo e o orçamento antes de qualquer serviço.</p>
        </div>
        <div class="bg-surface-dark border border-white/10 rounded-2xl p-8 text-center">
          <div class="w-14 h-14 rounded-full bg-primary/20 flex items-center justify-center mx-auto mb-5">
            <span class="material-symbols-outlined text-primary text-3xl">build</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">2. Reparo</h3>
          <p class="text-gray-400 text-sm">Após sua autorização, realizamos o serviço com peças de qualidade e garantia incluída.</p>
        </div>
        <div class="bg-surface-dark border border-white/10 rounded-2xl p-8 text-center">
          <div class="w-14 h-14 rounded-full bg-primary/20 flex items-center justify-center mx-auto mb-5">
            <span class="material-symbols-outlined text-primary text-3xl">verified</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">3. Garantia</h3>
          <p class="text-gray-400 text-sm">Todo serviço tem garantia. Se o problema persistir, você volta sem custo adicional.</p>
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section class="mt-20 max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-white mb-3">Preços e Dúvidas Frequentes</h2>
        <p class="text-gray-400 text-lg">Transparência total. Veja as faixas de preço dos serviços mais comuns.</p>
      </div>
      <script type="application/ld+json" set:html={faqSchema} />
      <div class="flex flex-col gap-4">
        <details class="group bg-surface-dark rounded-2xl overflow-hidden border border-gray-800 shadow-sm">
          <summary class="flex justify-between items-center font-bold cursor-pointer p-5 md:p-6 text-white text-base md:text-lg hover:bg-white/5 transition-colors">
            <span>Quanto custa trocar a tela do notebook?</span>
            <span class="transition group-open:rotate-180 material-symbols-outlined text-gray-400 bg-white/10 p-1.5 rounded-full">expand_more</span>
          </summary>
          <div class="text-gray-400 text-sm md:text-base px-6 pb-6 pt-2 leading-relaxed">
            O valor varia conforme o modelo e a disponibilidade de peça. Em média, a troca de tela para notebooks em Porto Alegre fica entre <strong class="text-white">R$ 250 e R$ 800</strong>, incluindo mão de obra e garantia.
          </div>
        </details>
        <details class="group bg-surface-dark rounded-2xl overflow-hidden border border-gray-800 shadow-sm">
          <summary class="flex justify-between items-center font-bold cursor-pointer p-5 md:p-6 text-white text-base md:text-lg hover:bg-white/5 transition-colors">
            <span>Quanto tempo leva um upgrade de HDD para SSD?</span>
            <span class="transition group-open:rotate-180 material-symbols-outlined text-gray-400 bg-white/10 p-1.5 rounded-full">expand_more</span>
          </summary>
          <div class="text-gray-400 text-sm md:text-base px-6 pb-6 pt-2 leading-relaxed">
            O serviço de upgrade para SSD leva em média de <strong class="text-white">2 a 4 horas</strong>, incluindo a migração completa do sistema e dados. O valor do SSD não está incluso — cobramos apenas a mão de obra.
          </div>
        </details>
        <details class="group bg-surface-dark rounded-2xl overflow-hidden border border-gray-800 shadow-sm">
          <summary class="flex justify-between items-center font-bold cursor-pointer p-5 md:p-6 text-white text-base md:text-lg hover:bg-white/5 transition-colors">
            <span>Quanto custa a formatação de um notebook?</span>
            <span class="transition group-open:rotate-180 material-symbols-outlined text-gray-400 bg-white/10 p-1.5 rounded-full">expand_more</span>
          </summary>
          <div class="text-gray-400 text-sm md:text-base px-6 pb-6 pt-2 leading-relaxed">
            A formatação com instalação limpa do Windows e drivers custa a partir de <strong class="text-white">R$ 120</strong>. Inclui backup básico dos dados, otimização e instalação de antivírus.
          </div>
        </details>
        <details class="group bg-surface-dark rounded-2xl overflow-hidden border border-gray-800 shadow-sm">
          <summary class="flex justify-between items-center font-bold cursor-pointer p-5 md:p-6 text-white text-base md:text-lg hover:bg-white/5 transition-colors">
            <span>Vocês atendem em domicílio em Porto Alegre?</span>
            <span class="transition group-open:rotate-180 material-symbols-outlined text-gray-400 bg-white/10 p-1.5 rounded-full">expand_more</span>
          </summary>
          <div class="text-gray-400 text-sm md:text-base px-6 pb-6 pt-2 leading-relaxed">
            Sim, fazemos atendimento presencial em Porto Alegre, especialmente nos bairros Cristal, Tristeza, Menino Deus e Centro. Também oferecemos <a href="/servicos" class="text-primary hover:text-accent transition-colors">suporte remoto</a> para toda a região metropolitana.
          </div>
        </details>
      </div>
    </section>

    {/* Final CTA */}
    <section class="mt-20 text-center">
      <div class="bg-surface-dark border border-gray-800 rounded-[2rem] p-10 md:p-16">
        <h2 class="text-3xl md:text-4xl font-black text-white mb-4">Tá com o notebook quebrado?</h2>
        <p class="text-gray-300 text-lg mb-8 max-w-xl mx-auto">Mande uma mensagem no WhatsApp que a gente resolve. Diagnóstico rápido e orçamento sem compromisso.</p>
        <a
          href="https://wa.me/5551993257923"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent hover:bg-accent-dark text-white font-bold text-lg h-16 px-10 shadow-lg transition-all hover:scale-105 active:scale-[0.98]"
        >
          <span class="material-symbols-outlined">chat</span>
          <span>Falar no WhatsApp</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
