const { slug } = Astro.props;
const currentService = servicos[slug as keyof typeof servicos];
const {
  titulo, description, h1, subtitulo, conteudo, sintomas,
  preco, prazo, garantia, icone, badge, whatsappMsg, faqPergunta, faqResposta
} = currentService;

const landingSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "name": "Sigel Soluções em Informática",
      "image": "https://sigelinformatica.com.br/images/logo.webp",
      "url": `https://sigelinformatica.com.br/servicos/hardware/${slug}`,
      "telephone": "+5551993257923",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Av. Icaraí, 1428 - Cristal",
        "addressLocality": "Porto Alegre",
        "addressRegion": "RS",
        "postalCode": "90810-000",
        "addressCountry": "BR"
      }
    },
    {
      "@type": "Service",
      "name": h1,
      "description": description,
      "provider": { "@type": "LocalBusiness", "name": "Sigel Soluções em Informática", "url": "https://sigelinformatica.com.br" },
      "areaServed": [{ "@type": "City", "name": "Porto Alegre" }, { "@type": "State", "name": "Rio Grande do Sul" }],
      "serviceType": h1
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": faqPergunta,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faqResposta.replace(/<[^>]*>/g, "")
          }
        },
        {
          "@type": "Question",
          "name": "Qual o prazo médio deste serviço?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `O prazo médio estimado é de ${prazo.toLowerCase()}, com garantia formal de 90 dias.`
          }
        }
      ]
    }
  ]
});

const brands = ["Dell", "Lenovo", "HP", "Acer", "Apple (MacBook)", "Asus", "Samsung", "Vaio", "Positivo"];
---

<Base
  title={titulo}
  description={description}
  canonical={`/servicos/hardware/${slug}`}
  breadcrumbs={[
    { name: "Serviços", path: "/servicos" },
    { name: "Hardware", path: "/servicos/hardware" },
    { name: h1, path: `/servicos/hardware/${slug}` }
  ]}
  schema={landingSchema}
>
  <Header />

  <main class="mx-auto w-full max-w-7xl px-5 md:px-12 pt-6 md:pt-12 pb-24">
    {/* Breadcrumbs Top Bar */}
    <nav class="flex items-center gap-2 text-xs text-gray-400 mb-6">
      <a href="/" class="hover:text-white transition-colors">Início</a>
      <span>/</span>
      <a href="/servicos/hardware" class="hover:text-white transition-colors">Hardware & Manutenção</a>
      <span>/</span>
      <span class="text-primary font-bold">{h1}</span>
    </nav>

    {/* Hero Section - High Conversion Layout */}
    <section class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-b from-[#0e1424] to-surface-dark border border-white/10 p-6 md:p-12 shadow-2xl">
      <div class="absolute -top-20 -right-20 w-80 h-80 bg-primary/20 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 items-center">
        {/* Left Column: Headlines & CTA */}
        <div class="lg:col-span-7 flex flex-col gap-5">
          {/* Trust Badges */}
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 bg-yellow-500/10 border border-yellow-500/30 px-3 py-1 rounded-full text-xs font-bold text-yellow-400">
              <span>★★★★★</span>
