export async function getStaticPaths() {
  return [
    { params: { slug: "troca-de-tela" }, props: { slug: "troca-de-tela" } },
    { params: { slug: "formatacao-pc" }, props: { slug: "formatacao-pc" } },
    { params: { slug: "troca-de-teclado" }, props: { slug: "troca-de-teclado" } },
    { params: { slug: "upgrade-ssd" }, props: { slug: "upgrade-ssd" } },
    { params: { slug: "manutencao-notebook" }, props: { slug: "manutencao-notebook" } },
    { params: { slug: "assistencia-tecnica" }, props: { slug: "assistencia-tecnica" } },
    { params: { slug: "recuperacao-dados" }, props: { slug: "recuperacao-dados" } },
    { params: { slug: "reparo-carcaca" }, props: { slug: "reparo-carcaca" } },
