---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const aboutSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "Sobre a Sigel Soluções em Informática",
  "description": "Conheça a Sigel Soluções em Informática. Desde 2018 ajudamos PMEs a crescer no digital com tecnologia, design e copywriting estratégico.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Sigel Soluções em Informática",
    "description": "Desde 2018 descomplicando tecnologia e marketing para PMEs brasileiras.",
    "foundingDate": "2018",
    "url": "https://sigelinformatica.com.br"
  }
});
---

<Base
  title="Sobre - Sigel | Quem Somos, Nossa Missão e História"
  description="Conheça a Sigel Soluções em Informática. Desde 2018 ajudamos PMEs a crescer no digital com tecnologia, design e copywriting estratégico."
  canonical="/sobre"
  breadcrumbs={[{ name: "Sobre", path: "/sobre" }]}
  schema={aboutSchema}
>
  <Header />

  <main class="w-full" style="background: #080707;">
    {/* ===== HERO: SPLIT LAYOUT ===== */}
    <section class="w-full px-5 md:px-12 pt-8 md:pt-16 pb-12 md:pb-20">
      <div class="max-w-7xl mx-auto">
        <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8 md:mb-12 font-medium">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-40"><polyline points="9 18 15 12 9 6"/></svg>
          <span class="text-gray-400">Sobre</span>
        </nav>

        <div class="flex flex-col md:flex-row gap-8 md:gap-16 items-center">
          <div class="w-full md:w-[55%] flex flex-col gap-5">
            <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-primary">
              <span class="w-5 h-px bg-primary/40"></span>
              Desde 2018
            </span>

            <h1 class="text-4xl md:text-5xl lg:text-6xl text-white font-black leading-[1.1] tracking-tight">
              Construindo pontes digitais para PMEs
            </h1>

            <p class="text-gray-400 text-base md:text-lg leading-relaxed max-w-xl">
              Descomplicamos tecnologia e marketing para pequenas e médias empresas — seja criando sites, automatizando processos ou consertando notebooks e PCs.
            </p>

            <div class="w-12 h-px bg-primary/30 mt-2"></div>
          </div>

          <div class="w-full md:w-[45%]">
            <div class="relative">
              <div class="absolute -inset-1 bg-gradient-to-br from-primary/20 to-transparent rounded-2xl blur-sm"></div>
              <div class="relative rounded-2xl overflow-hidden aspect-[4/3] border border-white/5">
                <picture>
                  <source srcset="/images/quemsomos.webp" type="image/webp" />
                  <img src="/images/quemsomos.webp" alt="Equipe Sigel Soluções em Informática" class="w-full h-full object-cover" />
                </picture>
                <div class="absolute inset-0 bg-gradient-to-t from-[#080707] via-transparent to-transparent"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ===== NOSSA HISTÓRIA ===== */}
    <section class="w-full px-5 md:px-12 py-16 md:py-24">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row gap-10 md:gap-20">
          <div class="w-full md:w-[240px] shrink-0">
            <span class="text-xs font-semibold uppercase tracking-wider text-primary/60">Trajetória</span>
            <div class="relative mt-8 pl-6 border-l border-white/5">
              {[
                { year: "2018", label: "Fundação da Sigel" },
                { year: "2019", label: "Primeiros notebooks consertados" },
                { year: "2020", label: "Primeiros sites entregues" },
                { year: "2022", label: "Expansão para automação" },
                { year: "2024", label: "Mais de 50 clientes ativos" },
              ].map((item) => (
                <div class="relative pb-8 last:pb-0">
                  <div class="absolute -left-[25px] top-1 w-3 h-3 rounded-full border-2 border-primary/60 bg-[#080707]"></div>
                  <span class="block text-sm font-bold text-primary">{item.year}</span>
                  <span class="block text-sm text-gray-500">{item.label}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="flex-1 flex flex-col gap-5 pt-0 md:pt-12">
            <h2 class="text-2xl md:text-3xl text-white font-bold tracking-tight leading-tight">
              Nossa História
            </h2>

            <p class="text-gray-300 text-base md:text-lg leading-relaxed">
              A Sigel Soluções em Informática nasceu com uma missão clara:
              descomplicar a tecnologia e o marketing para pequenas e
              médias empresas.
            </p>

            <p class="text-gray-400 text-base md:text-lg leading-relaxed">
              Começamos com assistência técnica — conserto de notebooks, formatação de PCs, recuperação de dados. Foi ajudando empresas a resolver seus problemas de hardware que entendemos de verdade as dores do empreendedor brasileiro.
            </p>

            <p class="text-gray-400 text-base md:text-lg leading-relaxed">
              Com o tempo, expandimos para <a href="/web" class="text-primary hover:text-primary-dark transition-colors">desenvolvimento web</a>, <a href="/automacao" class="text-primary hover:text-primary-dark transition-colors">automação de processos</a> e <a href="/copywriting" class="text-primary hover:text-primary-dark transition-colors">copywriting estratégico</a> — mas sem nunca abandonar nossa base: o suporte técnico que resolve de verdade. Hoje oferecemos <a href="/servicos/hardware" class="text-primary hover:text-primary-dark transition-colors">manutenção de computadores em Porto Alegre</a> com o mesmo cuidado de sempre.
            </p>

            <p class="text-gray-400 text-base md:text-lg leading-relaxed">
              Atendemos clientes de norte a sul do Brasil, com suporte remoto e presença dedicada em Porto Alegre — sempre com o espírito de parceria real que nos define desde o primeiro dia.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ===== NOSSO ALCANCE ===== */}
    <section class="w-full px-5 md:px-12 py-16 md:py-20" style="background: #0a0908;">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-xs font-semibold uppercase tracking-wider text-primary/60">Números</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-10">
          {[
            { value: "100+", label: "PMEs Atendidas", icon: "business" },
            { value: "500+", label: "Notebooks Consertados", icon: "repair" },
            { value: "98%", label: "Retenção de Clientes", icon: "favorite" },
          ].map((stat) => (
            <div class="text-center p-8 rounded-2xl border border-white/5 bg-white/[0.02] hover:bg-white/[0.04] transition-colors">
              <div class="w-10 h-10 mx-auto mb-5 rounded-lg bg-primary/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-primary text-xl">{stat.icon}</span>
              </div>
              <p class="text-3xl md:text-4xl text-white font-black tracking-tight mb-2">{stat.value}</p>
              <p class="text-sm text-gray-500">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ===== NOSSA FILOSOFIA ===== */}
    <section class="w-full px-5 md:px-12 py-16 md:py-24">
      <div class="max-w-7xl mx-auto">
        <div class="mb-12 md:mb-16">
          <span class="text-xs font-semibold uppercase tracking-wider text-primary/60">Filosofia</span>
          <h2 class="text-2xl md:text-3xl text-white font-bold tracking-tight mt-3 leading-tight">
            Como pensamos
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            {
              icon: "visibility",
              title: "Clareza Absoluta",
              desc: "Transformamos processos complexos em planos de ação simples, educando nossos clientes em cada passo da jornada — seja montando um site ou recuperando dados de um notebook.",
              accent: "#f65e37",
            },
            {
              icon: "trending_up",
              title: "Foco em Conversão",
              desc: "Não fazemos 'arte pela arte'. Todo design, texto e código que sai das nossas mãos é intencionalmente focado em gerar crescimento comercial.",
              accent: "#f65e37",
            },
            {
              icon: "support_agent",
              title: "Parceria Real",
              desc: "Estamos do lado do cliente. Seja resolvendo um problema técnico urgente ou planejando o próximo lançamento digital — cada entrega nossa é tratada com a mesma dedicação.",
              accent: "#f65e37",
            },
          ].map((card) => (
            <div
              class="group relative p-8 rounded-2xl border border-white/5 bg-white/[0.02] transition-all duration-500"
              style={`--accent: ${card.accent}`}
            >
              <div class="relative z-10">
                <div
                  class="w-12 h-12 rounded-xl flex items-center justify-center mb-6 transition-all duration-500 group-hover:scale-110"
                  style="background: rgba(246, 94, 55, 0.1); color: var(--accent)"
                >
                  <span class="material-symbols-outlined text-2xl">{card.icon}</span>
                </div>
                <h3 class="text-white text-lg font-bold mb-3 tracking-tight">{card.title}</h3>
                <p class="text-gray-400 text-sm leading-relaxed">{card.desc}</p>
              </div>
              <div
                class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                style="background: radial-gradient(ellipse at 50% 0%, rgba(246,94,55,0.04) 0%, transparent 70%)"
              ></div>
              <div
                class="absolute bottom-0 left-[10%] right-[10%] h-px opacity-0 group-hover:opacity-100 transition-opacity duration-500"
                style="background: linear-gradient(90deg, transparent, rgba(246,94,55,0.2), transparent)"
              ></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ===== TIMELINE ===== */}
    <section class="w-full px-5 md:px-12 py-16 md:py-24" style="background: #0a0908;">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-14">
          <span class="text-xs font-semibold uppercase tracking-wider text-primary/60">Jornada</span>
          <h2 class="text-2xl md:text-3xl text-white font-bold tracking-tight mt-3">Nossa evolução</h2>
        </div>

        <div class="relative">
          <div class="absolute top-[18px] left-0 right-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent hidden md:block"></div>

          <div class="flex flex-col md:flex-row md:justify-between gap-8 md:gap-0">
            {[
              { year: "2018", label: "Fundação", desc: "A Sigel nasce em Porto Alegre" },
              { year: "2019", label: "Suporte Técnico", desc: "Primeiros serviços de manutenção de PCs" },
              { year: "2020", label: "Desenvolvimento Web", desc: "Primeiros projetos web entregues" },
              { year: "2024", label: "50+ Clientes", desc: "Mais de 50 PMEs atendidas" },
              { year: "2026", label: "Hoje", desc: "Sites, automação, hardware e suporte" },
            ].map((item) => (
              <div class="relative flex md:flex-col items-center gap-4 md:gap-0 md:text-center flex-1">
                <div class="md:order-2">
                  <div class="w-[14px] h-[14px] rounded-full border-2 border-primary/50 bg-[#0a0908] relative z-10"></div>
                </div>
                <div class="md:order-1 md:mb-4">
                  <span class="block text-primary text-sm font-bold">{item.year}</span>
                </div>
                <div class="md:order-3 md:mt-4 flex-1 md:flex-none">
                  <span class="block text-white text-sm font-semibold">{item.label}</span>
                  <span class="block text-gray-600 text-xs mt-1 hidden md:block">{item.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ===== CTA ===== */}
    <section class="w-full px-5 md:px-12 py-16 md:py-24">
      <div class="max-w-6xl mx-auto">
        <div class="relative rounded-[2rem] overflow-hidden p-8 md:p-14 lg:p-16" style="background: linear-gradient(135deg, #141110 0%, #1a1512 100%);">
          <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-10 pointer-events-none" style="background: radial-gradient(circle, #f65e37 0%, transparent 70%);"></div>
          <div class="absolute bottom-0 left-0 w-64 h-64 rounded-full opacity-10 pointer-events-none" style="background: radial-gradient(circle, #f65e37 0%, transparent 70%);"></div>

          <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8 md:gap-16">
            <div class="flex flex-col gap-4 max-w-xl">
              <h2 class="text-3xl md:text-4xl lg:text-5xl text-white font-black tracking-tight leading-tight">
                Pronto para finalmente crescer no digital?
              </h2>
              <p class="text-gray-400 text-base md:text-lg leading-relaxed">
                Agende uma conversa detalhada e sem compromisso para descobrir o real potencial de conversão da sua empresa.
              </p>
            </div>

            <a
              href="https://wa.me/555191305583?text=Ol%C3%A1%21%20Estava%20no%20site%20da%20Sigel%20e%20gostaria%20de%20solicitar%20um%20diagn%C3%B3stico%20gratuito%20para%20o%20meu%20neg%C3%B3cio."
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 w-full md:w-auto inline-flex items-center justify-center gap-3 py-4 px-8 md:px-10 rounded-xl font-bold text-base md:text-lg text-white transition-all hover:scale-105 active:scale-95 shadow-lg shadow-primary/20"
              style="background: linear-gradient(135deg, #f65e37, #d54e2b);"
            >
              <span class="material-symbols-outlined text-[24px]">rocket_launch</span>
              <span>Falar com nosso Consultor</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
