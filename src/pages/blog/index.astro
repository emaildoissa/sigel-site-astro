---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.tsx";
import Footer from "../../components/Footer.astro";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base
  title="Blog Sigel | Artigos sobre Desenvolvimento Web e TI"
  description="Fique por dentro das novidades sobre criação de sites, automação, copywriting e manutenção de informática em Porto Alegre."
  canonical="/blog"
  breadcrumbs={[{ name: "Blog", path: "/blog" }]}
>
  <Header client:load />

  <section class="px-5 md:px-12 py-32 md:py-40 bg-[#050505] min-h-screen">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-black text-white mb-4">Blog</h1>
      <p class="text-gray-400 text-lg mb-12 max-w-2xl">
        Insights, tutoriais e dicas de negócio para acelerar o crescimento da sua empresa no digital.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="group flex flex-col bg-surface-dark border border-white/10 rounded-2xl overflow-hidden hover:border-primary/50 transition-all hover:-translate-y-1">
            {post.data.image ? (
              <div class="w-full h-48 overflow-hidden">
                <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            ) : (
              <div class="w-full h-48 bg-white/5 flex items-center justify-center">
                <span class="material-symbols-outlined text-4xl text-gray-600">article</span>
              </div>
            )}
            <div class="p-6 flex flex-col flex-1">
              <time class="text-xs text-primary font-bold tracking-wider uppercase mb-2">
                {post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
              </time>
              <h2 class="text-xl font-bold text-white mb-3 line-clamp-2">{post.data.title}</h2>
              <p class="text-gray-400 text-sm line-clamp-3 mb-4">{post.data.description}</p>
              <div class="mt-auto flex items-center text-primary text-sm font-semibold gap-1 group-hover:gap-2 transition-all">
                Ler artigo <span class="material-symbols-outlined text-sm">arrow_forward</span>
              </div>
            </div>
          </a>
        ))}

        {posts.length === 0 && (
          <div class="col-span-full py-12 text-center border border-white/10 rounded-2xl bg-white/5">
            <p class="text-gray-400">Nenhum artigo publicado ainda.</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <Footer />
</Base>
