---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = await getCollection("blog");
const related = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 3);

const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "image": post.data.image ? [`https://sigelinformatica.com.br${post.data.image}`] : [],
  "author": {
    "@type": "Organization",
    "name": post.data.author,
    "url": "https://sigelinformatica.com.br"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Sigel Soluções em Informática",
    "url": "https://sigelinformatica.com.br",
    "logo": {
      "@type": "ImageObject",
      "url": "https://sigelinformatica.com.br/images/logo.webp"
    }
  },
  "datePublished": post.data.pubDate.toISOString()
});

const categoryColors: Record<string, string> = {
  web: "#f65e37",
  hardware: "#3b82f6",
  automacao: "#10b981",
  copywriting: "#8b5cf6",
  negocios: "#f59e0b",
};

const categoryLabels: Record<string, string> = {
  web: "Web",
  hardware: "Hardware",
  automacao: "Automação",
  copywriting: "Copywriting",
  negocios: "Negócios",
};

const cat = post.data.category || "web";
const catColor = categoryColors[cat] || "#f65e37";

const placeholderGradients: Record<string, string> = {
  web: "linear-gradient(135deg, #1a110e 0%, #2a1810 50%, #1a110e 100%)",
  hardware: "linear-gradient(135deg, #0e121a 0%, #10182a 50%, #0e121a 100%)",
  automacao: "linear-gradient(135deg, #0e1a12 0%, #102a18 50%, #0e1a12 100%)",
  copywriting: "linear-gradient(135deg, #120e1a 0%, #1a102a 50%, #120e1a 100%)",
  negocios: "linear-gradient(135deg, #1a160e 0%, #2a2210 50%, #1a160e 100%)",
};

const shareUrl = `https://sigelinformatica.com.br/blog/${post.id}`;
---

<Base
  title={`${post.data.title} - Sigel`}
  description={post.data.description}
  canonical={`/blog/${post.id}`}
  ogType="article"
  ogImage={post.data.image}
  schema={articleSchema}
  breadcrumbs={[
    { name: "Blog", path: "/blog" },
    { name: post.data.title, path: `/blog/${post.id}` },
  ]}
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />

  <Header />

  <div id="progress-bar" class="fixed top-0 left-0 h-[3px] z-[100] pointer-events-none" style={`background: linear-gradient(90deg, ${catColor}, ${catColor}88); width: 0%;`}></div>

  <article class="px-5 md:px-12 py-28 md:py-36 bg-[#050505] min-h-screen">
    <div class="max-w-5xl mx-auto">
      <nav class="flex items-center gap-2 text-sm text-gray-500 mb-10 font-['DM_Sans',sans-serif]">
        <a href="/" class="hover:text-gray-300 transition-colors">Home</a>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-40"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/blog" class="hover:text-gray-300 transition-colors">Blog</a>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-40"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-gray-400 truncate max-w-[200px]">{post.data.title}</span>
      </nav>

      <header class="mb-14">
        <div class="flex items-center gap-4 mb-5">
          <span class="inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-wider" style={`color: ${catColor}; font-family: 'DM Sans', sans-serif;`}>
            <span class="w-2 h-2 rounded-full" style={`background: ${catColor}`}></span>
            {categoryLabels[cat] || cat}
          </span>
          <span class="text-xs text-gray-600 font-['DM_Sans',sans-serif]">·</span>
          <span class="text-xs text-gray-500 font-['DM_Sans',sans-serif]">
            {post.data.pubDate.toLocaleDateString('pt-BR', {
              day: '2-digit',
              month: 'long',
              year: 'numeric'
            })}
          </span>
          {post.data.readingTime && (
            <>
              <span class="text-xs text-gray-600 font-['DM_Sans',sans-serif]">·</span>
              <span class="text-xs text-gray-500 font-['DM_Sans',sans-serif]">
                {post.data.readingTime} min de leitura
              </span>
            </>
          )}
        </div>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-white leading-tight mb-5" style="font-family: 'Sora', sans-serif;">
          {post.data.title}
        </h1>
        <p class="text-lg md:text-xl text-gray-400 leading-relaxed max-w-3xl" style="font-family: 'DM Sans', sans-serif;">
          {post.data.description}
        </p>
      </header>

      {post.data.image ? (
        <div class="w-full rounded-2xl overflow-hidden aspect-video border border-white/5 mb-14">
          <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover" />
        </div>
      ) : (
        <div class="w-full rounded-2xl overflow-hidden aspect-video mb-14" style={`background: ${placeholderGradients[cat] || placeholderGradients.web}`}>
          <div class="w-full h-full flex items-center justify-center">
            <div class="grid grid-cols-3 gap-8 opacity-10 p-12">
              {[0,1,2,3,4,5].map((i) => (
                i % 2 === 0
                  ? <div key={i} class="w-2 h-2 rounded-full" style={`background: ${catColor}`}></div>
                  : <div key={i} class="h-px self-center" style={`background: ${catColor}`}></div>
              ))}
            </div>
          </div>
        </div>
      )}

      <div class="flex flex-col lg:flex-row gap-12 relative">
        {headings.length > 1 && (
          <>
            <aside class="lg:w-56 shrink-0">
              <div class="lg:sticky lg:top-28" id="toc-desktop">
                <h3 class="text-white text-sm font-semibold mb-4 uppercase tracking-wider flex items-center gap-2" style="font-family: 'Sora', sans-serif;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                  Índice
                </h3>
                <ul class="flex flex-col gap-2 text-sm" id="toc-list">
                  {headings.map((heading) => (
                    <li class={heading.depth > 2 ? "pl-4" : ""}>
                      <a
                        href={`#${heading.slug}`}
                        class="toc-link block text-gray-500 hover:text-gray-300 transition-colors py-1 border-l-2 border-transparent hover:border-gray-600 pl-3 -ml-1"
                        style="font-family: 'DM Sans', sans-serif;"
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </aside>

            <button
              id="toc-mobile-toggle"
              class="lg:hidden flex items-center gap-2 text-sm text-gray-400 hover:text-white transition-colors mb-6 font-['DM_Sans',sans-serif]"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              Índice do Artigo
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div id="toc-mobile" class="lg:hidden hidden mb-8 bg-white/[0.03] border border-white/[0.06] rounded-xl p-4">
              <ul class="flex flex-col gap-2 text-sm">
                {headings.map((heading) => (
                  <li class={heading.depth > 2 ? "pl-4" : ""}>
                    <a
                      href={`#${heading.slug}`}
                      class="toc-link block text-gray-400 hover:text-white transition-colors py-1"
                      style="font-family: 'DM Sans', sans-serif;"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </>
        )}

        <div class="flex-1 min-w-0 max-w-3xl">
          <div class="mb-8">
            <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-300 transition-colors font-['DM_Sans',sans-serif]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
              Voltar para o Blog
            </a>
          </div>

          {post.data.keyTakeaways && post.data.keyTakeaways.length > 0 && (
             <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-6 mb-10">
               <h3 class="text-white font-semibold text-base mb-4 flex items-center gap-2" style="font-family: 'Sora', sans-serif;">
                 <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style={`color: ${catColor}`}><path d="M9 18l6-6-6-6"/></svg>
                 Principais Pontos
               </h3>
               <ul class="flex flex-col gap-2.5">
                 {post.data.keyTakeaways.map((point: string) => (
                   <li class="flex items-start gap-2.5 text-gray-300 text-sm leading-relaxed" style="font-family: 'DM Sans', sans-serif;">
                     <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5" style={`color: ${catColor}`}><polyline points="20 6 9 17 4 12"/></svg>
                     <span>{point}</span>
                   </li>
                 ))}
               </ul>
             </div>
          )}

          <div class="prose-custom">
            <Content />
          </div>

          <div class="mt-14 pt-8 border-t border-white/5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <span class="text-sm text-gray-500 font-['DM_Sans',sans-serif]">Compartilhe este artigo</span>
              <div class="flex items-center gap-3">
                <a
                  href={`https://wa.me/?text=${encodeURIComponent(post.data.title + " " + shareUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-9 h-9 rounded-full bg-white/5 hover:bg-[#25D366]/20 border border-white/10 hover:border-[#25D366]/30 flex items-center justify-center text-gray-400 hover:text-[#25D366] transition-all"
                  aria-label="Compartilhar no WhatsApp"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.607-2.059-.125-.297.013-.458.26-.674.126-.123.263-.322.33-.515.065-.194.033-.36-.016-.498-.05-.139-.422-1.043-.58-1.423-.157-.38-.314-.319-.445-.319-.133 0-.287-.014-.445.014-.142.028-.33.142-.392.283-.116.29-1.003 1.265-1.003 2.405 0 1.14.83 2.24.947 2.394.116.154 1.617 2.477 3.933 3.454.548.232.976.37 1.31.473.549.17 1.05.147 1.447.093.46-.062 1.456-.595 1.66-1.168.204-.574.204-1.065.141-1.16-.062-.095-.226-.149-.472-.246z"/><path d="M12 2C6.48 2 2 6.48 2 12c0 2.11.66 4.07 1.78 5.68L2.5 21.5l3.82-1.28C7.87 21.18 9.88 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm0 18c-1.85 0-3.57-.64-4.93-1.72l-.34-.26-2.28.76.76-2.28-.26-.34A7.82 7.82 0 0 1 4 12c0-4.41 3.59-8 8-8s8 3.59 8 8-3.59 8-8 8z"/></svg>
                </a>
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-9 h-9 rounded-full bg-white/5 hover:bg-[#0A66C2]/20 border border-white/10 hover:border-[#0A66C2]/30 flex items-center justify-center text-gray-400 hover:text-[#0A66C2] transition-all"
                  aria-label="Compartilhar no LinkedIn"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
                <button
                  id="copy-link-btn"
                  class="w-9 h-9 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 flex items-center justify-center text-gray-400 hover:text-white transition-all"
                  aria-label="Copiar link"
                  data-url={shareUrl}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                </button>
              </div>
            </div>
          </div>

          <div class="mt-10 pt-8 border-t border-white/5">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center text-sm font-semibold text-gray-400" style="font-family: 'Sora', sans-serif;">
                SG
              </div>
              <div>
                <p class="text-white text-sm font-semibold" style="font-family: 'Sora', sans-serif;">{post.data.author}</p>
                <p class="text-gray-500 text-xs mt-0.5" style="font-family: 'DM Sans', sans-serif;">
                  Expert em soluções digitais para PMEs. Ajudamos negócios a crescer com tecnologia, estratégia e conteúdo de alta performance.
                </p>
              </div>
            </div>
          </div>

          {related.length > 0 && (
            <div class="mt-14 pt-10 border-t border-white/5">
              <h3 class="text-white text-lg font-semibold mb-6" style="font-family: 'Sora', sans-serif;">
                Artigos Relacionados
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                {related.map((rel) => (
                  <a
                    href={`/blog/${rel.id}`}
                    class="group block bg-white/[0.02] border border-white/[0.06] rounded-xl p-5 hover:bg-white/[0.04] transition-colors"
                  >
                    <span class="inline-flex items-center gap-1.5 text-[10px] font-medium uppercase tracking-wider mb-3" style={`color: ${categoryColors[rel.data.category || "web"]}; font-family: 'DM Sans', sans-serif;`}>
                      <span class="w-1.5 h-1.5 rounded-full" style={`background: ${categoryColors[rel.data.category || "web"]}`}></span>
                      {categoryLabels[rel.data.category || "web"]}
                    </span>
                    <h4 class="text-white text-sm font-semibold leading-snug line-clamp-2 group-hover:text-gray-200 transition-colors" style="font-family: 'Sora', sans-serif;">
                      {rel.data.title}
                    </h4>
                    <p class="text-gray-500 text-xs mt-2 line-clamp-2" style="font-family: 'DM Sans', sans-serif;">
                      {rel.data.description}
                    </p>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="mt-10 text-center">
            <a href="/blog" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-300 transition-colors font-['DM_Sans',sans-serif]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
              Voltar para todos os artigos
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <Footer />
</Base>

<style>
  .prose-custom {
    font-family: "DM Sans", sans-serif;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.8);
    max-width: 70ch;
  }

  .prose-custom > * + * {
    margin-top: 1.25em;
  }

  .prose-custom h2 {
    font-family: "Sora", sans-serif;
    font-size: 1.625rem;
    font-weight: 700;
    color: #fff;
    margin-top: 2.5em;
    margin-bottom: 0.6em;
    line-height: 1.3;
  }

  .prose-custom h3 {
    font-family: "Sora", sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #fff;
    margin-top: 2em;
    margin-bottom: 0.5em;
    line-height: 1.35;
  }

  .prose-custom p {
    margin-bottom: 1.25em;
  }

  .prose-custom a {
    color: #f65e37;
    text-decoration: none;
    transition: color 0.2s;
    border-bottom: 1px solid rgba(246, 94, 55, 0.2);
  }

  .prose-custom a:hover {
    color: #f65e37;
    border-bottom-color: #f65e37;
  }

  .prose-custom strong {
    color: #fff;
    font-weight: 500;
  }

  .prose-custom blockquote {
    border-left: 3px solid #f65e37;
    padding-left: 1.25em;
    margin: 1.5em 0;
    color: rgba(255, 255, 255, 0.55);
    font-style: italic;
    font-size: 1.05em;
  }

  .prose-custom ul,
  .prose-custom ol {
    padding-left: 1.5em;
    margin: 1em 0;
  }

  .prose-custom li {
    margin-bottom: 0.4em;
  }

  .prose-custom ul li {
    list-style-type: disc;
  }

  .prose-custom ol li {
    list-style-type: decimal;
  }

  .prose-custom img {
    border-radius: 12px;
    margin: 2em 0;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .prose-custom code {
    font-family: "JetBrains Mono", "DM Sans", monospace;
    font-size: 0.875em;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    color: #f65e37;
  }

  .prose-custom pre {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 1.25em;
    overflow-x: auto;
    margin: 1.5em 0;
  }

  .prose-custom pre code {
    background: none;
    padding: 0;
    border-radius: 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.85em;
  }

  .prose-custom hr {
    border: none;
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
    margin: 2.5em 0;
  }

  .prose-custom table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
    font-size: 0.95em;
  }

  .prose-custom th {
    text-align: left;
    padding: 0.75em 1em;
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
    font-weight: 500;
    font-family: "Sora", sans-serif;
    font-size: 0.85em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .prose-custom td {
    padding: 0.75em 1em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.7);
  }

  .prose-custom h2:first-child,
  .prose-custom h3:first-child {
    margin-top: 0;
  }

  .toc-link.active {
    color: #f65e37;
    border-left-color: #f65e37;
  }

  @media (prefers-reduced-motion: reduce) {
    #progress-bar {
      display: none;
    }
  }
</style>

<script>
  (function() {
    var progressBar = document.getElementById("progress-bar");
    if (progressBar) {
      function updateProgress() {
        var scrollTop = window.scrollY;
        var docHeight = document.documentElement.scrollHeight - window.innerHeight;
        var progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressBar.style.width = Math.min(progress, 100) + "%";
      }
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();
    }

    var tocLinks = document.querySelectorAll(".toc-link");
    var headings = [];
    tocLinks.forEach(function(link) {
      var href = link.getAttribute("href");
      if (href && href.startsWith("#")) {
        var id = href.slice(1);
        var el = document.getElementById(id);
        if (el) headings.push({ el: el, link: link });
      }
    });

    if (headings.length > 0) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            tocLinks.forEach(function(l) { l.classList.remove("active"); });
            var matched = headings.find(function(h) { return h.el === entry.target; });
            if (matched) matched.link.classList.add("active");
          }
        });
      }, { rootMargin: "-80px 0px -70% 0px" });

      headings.forEach(function(h) { observer.observe(h.el); });
    }

    var tocMobileToggle = document.getElementById("toc-mobile-toggle");
    var tocMobile = document.getElementById("toc-mobile");
    if (tocMobileToggle && tocMobile) {
      tocMobileToggle.addEventListener("click", function() {
        var expanded = tocMobile.classList.toggle("hidden");
        var arrow = tocMobileToggle.querySelector("svg:last-child");
        if (arrow) arrow.style.transform = expanded ? "rotate(0deg)" : "rotate(180deg)";
      });
    }

    var copyBtn = document.getElementById("copy-link-btn");
    if (copyBtn) {
      copyBtn.addEventListener("click", function() {
        var url = copyBtn.getAttribute("data-url");
        if (navigator.clipboard && url) {
          navigator.clipboard.writeText(url).then(function() {
            var original = copyBtn.innerHTML;
            copyBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
            setTimeout(function() { copyBtn.innerHTML = original; }, 2000);
          });
        }
      });
    }

    var mobileTocLinks = tocMobile ? tocMobile.querySelectorAll(".toc-link") : [];
    mobileTocLinks.forEach(function(link) {
      link.addEventListener("click", function() {
        if (tocMobile) tocMobile.classList.add("hidden");
        var arrow = tocMobileToggle ? tocMobileToggle.querySelector("svg:last-child") : null;
        if (arrow) arrow.style.transform = "rotate(0deg)";
      });
    });
  })();
</script>
