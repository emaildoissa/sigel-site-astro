  <script>
    (function () {
      const quizContainer = document.getElementById("quiz-container");
      if (!quizContainer) return;

      const steps = document.querySelectorAll(".quiz-step");
      const dots = document.querySelectorAll(".step-dot");
      const options = document.querySelectorAll(".quiz-option");
      const resultDiv = document.getElementById("quiz-result");
      const quizContent = document.getElementById("quiz-content");
      const restartBtn = document.getElementById("quiz-restart");
      const riskRing = document.getElementById("risk-ring");
      const riskPercent = document.getElementById("risk-percent");
      const riskTitle = document.getElementById("risk-title");
      const riskDesc = document.getElementById("risk-desc");
      const quizCta = document.getElementById("quiz-cta");

      let currentStep = 0;
      let totalRisk = 0;
      const maxRisk = parseInt(quizContainer.dataset.maxRisk) || 36;

      function goToStep(stepIndex) {
        steps.forEach((s, i) => {
          s.classList.toggle("hidden", i !== stepIndex);
        });
        dots.forEach((dot, i) => {
          dot.style.background =
            i <= stepIndex ? "#f65e37" : "rgba(255,255,255,0.1)";
        });
      }

      function showResult() {
        quizContent.classList.add("hidden");
        resultDiv.classList.remove("hidden");

        const percent = Math.round((totalRisk / maxRisk) * 100);
        const circumference = 339.292;
        const offset = circumference - (percent / 100) * circumference;

        setTimeout(() => {
          riskRing.style.transition = "stroke-dashoffset 1s ease-out";
          riskRing.style.strokeDashoffset = offset;
        }, 100);

        riskPercent.textContent = `${percent}%`;

        if (percent <= 30) {
          riskTitle.textContent = "Risco Baixo";
          riskDesc.textContent =
            "Sua empresa está bem encaminhada, mas a manutenção preventiva garante que continue assim. Que tal garantir essa tranquilidade?";
          riskRing.style.stroke = "#22c55e";
        } else if (percent <= 60) {
          riskTitle.textContent = "Risco Moderado";
          riskDesc.textContent =
            "Você já sentiu algum susto, mas ainda dá tempo de estruturar uma proteção sólida antes do próximo problema.";
          riskRing.style.stroke = "#eab308";
        } else {
          riskTitle.textContent = "Risco Alto";
          riskDesc.textContent =
            "Sua empresa está exposta. Um PC parado por alguns dias pode custar caro. Hora de agir.";
          riskRing.style.stroke = "#ef4444";
        }

        const ctaMsg = encodeURIComponent(
          `Olá! Fiz o diagnóstico de risco no site da Sigel e meu nível foi ${percent}% (${riskTitle.textContent}). Gostaria de agendar um diagnóstico completo gratuito para minha empresa.`,
        );
        quizCta.href = `https://wa.me/555193257923?text=${ctaMsg}`;
      }

      function resetQuiz() {
        currentStep = 0;
        totalRisk = 0;
        resultDiv.classList.add("hidden");
        quizContent.classList.remove("hidden");
        riskRing.style.transition = "none";
        riskRing.style.strokeDashoffset = 339.292;
        goToStep(0);
      }

      options.forEach((btn) => {
        btn.addEventListener("click", function () {
          const step = parseInt(this.dataset.step);
          const risk = parseInt(this.dataset.risk);
          totalRisk += risk;

          if (step < steps.length - 1) {
            currentStep = step + 1;
            goToStep(currentStep);
          } else {
            showResult();
          }
        });
      });

      restartBtn.addEventListener("click", resetQuiz);

      // Init
      goToStep(0);
    })();
  </script>
