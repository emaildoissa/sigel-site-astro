---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Contratos de Manutenção Preventiva de TI",
  description:
    "Suporte técnico ágil, help desk remoto, otimização contínua de desempenho e manutenção física preventiva para empresas em Porto Alegre por um valor mensal fixo.",
  provider: {
    "@type": "LocalBusiness",
    name: "Sigel Soluções em Informática",
    url: "https://sigelinformatica.com.br",
  },
  areaServed: [
    { "@type": "City", name: "Porto Alegre" },
    { "@type": "Country", name: "Brasil" },
  ],
  serviceType: "Manutenção Preventiva de TI",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Planos de Assinatura",
    itemListElement: [
      { "@type": "Offer", name: "Starter", price: "97", priceCurrency: "BRL" },
      {
        "@type": "Offer",
        name: "Business",
        price: "247",
        priceCurrency: "BRL",
      },
      {
        "@type": "Offer",
        name: "Corporate",
        price: "497",
        priceCurrency: "BRL",
      },
    ],
  },
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Preciso assinar por quanto tempo?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nossos planos são mensais e podem ser cancelados quando você quiser, sem multa. Recomendamos permanecer pelo menos 3 meses para sentir os benefícios reais da manutenção preventiva e otimização contínua.",
      },
    },
    {
      "@type": "Question",
      name: "E se nenhum computador quebrar, ainda assim pago?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Sim, porque o objetivo da manutenção preventiva é exatamente evitar que as máquinas quebrem ou fiquem lentas. Realizamos otimizações periódicas de sistema, limpeza física preventiva e você tem help desk imediato para qualquer dúvida do dia a dia.",
      },
    },
    {
      "@type": "Question",
      name: "Vocês atendem presencialmente em Porto Alegre?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Sim, atendemos presencialmente em Porto Alegre e região metropolitana. A maioria dos chamados e dúvidas de rotina é resolvida por acesso remoto em minutos, e realizamos visitas para limpeza física periódica ou problemas que exijam suporte no local.",
      },
    },
    {
      "@type": "Question",
      name: "Posso cancelar quando quiser?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Sim. Sem multa, sem burocracia. Basta avisar com 30 dias de antecedência.",
      },
    },
    {
      "@type": "Question",
      name: "O que está incluso na manutenção preventiva?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Inclui suporte remoto e help desk para problemas do dia a dia (impressoras, rede, e-mail, lentidão), otimização periódica do Windows, limpeza de arquivos desnecessários, manutenção física com troca de pasta térmica e consultoria para upgrades de equipamentos.",
      },
    },
    {
      "@type": "Question",
      name: "Quanto tempo leva para ativar o plano?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "O onboarding completo leva de 2 a 5 dias úteis. Realizamos um diagnóstico inicial em todas as máquinas, fazemos a primeira otimização de sistema e alinhamos o canal direto de suporte no WhatsApp.",
      },
    },
  ],
});

const quizSteps = [
  {
    question: "Quantos computadores sua empresa usa?",
    options: [
      { label: "Apenas o meu", value: "1-3", risk: 2 },
      { label: "De 4 a 10", value: "4-10", risk: 4 },
      { label: "Mais de 10", value: "10+", risk: 6 },
    ],
  },
  {
    question: "Você já perdeu dados importantes?",
    options: [
      { label: "Nunca perdi", value: "nao", risk: 1 },
      { label: "Já perdi uma vez", value: "uma-vez", risk: 5 },
      { label: "Já perdi mais de uma vez", value: "multiplas", risk: 8 },
    ],
  },
  {
    question: "Tem backup automatizado hoje?",
    options: [
      { label: "Sim, cloud automático", value: "sim", risk: 1 },
      { label: "Faço backup manual", value: "manual", risk: 5 },
      { label: "Não tenho backup", value: "nao", risk: 9 },
    ],
  },
  {
    question: "Quando um PC para, quanto tempo até resolver?",
    options: [
      { label: "Resolvo em horas", value: "horas", risk: 2 },
      { label: "Leva dias", value: "dias", risk: 6 },
      { label: "Mais de uma semana", value: "semanas", risk: 9 },
    ],
  },
];

const planos = [
  {
    name: "Starter",
    tagline: "Para profissionais liberais e home office",
    price: 97,
    description:
      "Mantenha seu computador sempre rápido e com help desk prioritário direto no WhatsApp.",
    features: [
      "Suporte remoto e help desk ágil",
      "Otimização periódica do sistema",
      "Limpeza de lixo digital e arquivos temporários",
      "Gestão de atualizações do Windows",
      "Consultoria para compras e upgrades",
      "Atendimento em horário comercial",
    ],
    cta: "Quero o Plano Starter",
    highlight: false,
  },
  {
    name: "Business",
    tagline: "Para pequenas e médias empresas",
    price: 247,
    description:
      "Sua empresa com computadores otimizados, suporte presencial e manutenção física periódica.",
    features: [
      "Tudo do Plano Starter",
      "Até 5 computadores inclusos",
      "Limpeza física semestral e troca de pasta térmica",
      "Atendimento presencial prioritário",
      "Suporte a impressoras e rede do escritório",
      "Diagnóstico de saúde das máquinas",
      "Suporte estendido até 20h",
    ],
    cta: "Quero o Plano Business",
    highlight: true,
  },
  {
    name: "Corporate",
    tagline: "Para empresas com múltiplos equipamentos",
    price: 497,
    description:
      "Gestão técnica completa para o escritório, com SLA ágil de 2 horas e suporte total a infraestrutura.",
    features: [
      "Tudo do Plano Business",
      "Até 10+ computadores e notebooks",
      "SLA de atendimento prioritário em 2 horas",
      "Visitas técnicas preventivas programadas",
      "Gestão de rede local e roteadores",
      "Planejamento de upgrades e infraestrutura",
      "Canal de suporte direto prioritário",
    ],
    cta: "Quero o Plano Corporate",
    highlight: false,
  },
];
---

<Base
  title="Contratos de Manutenção de TI | Sigel"
  description="Suporte técnico ágil para empresas em Porto Alegre. Help desk remoto, otimização contínua de desempenho e manutenção física preventiva por valor fixo."
  canonical="/contratos"
  breadcrumbs={[{ name: "Contratos", path: "/contratos" }]}
  schema={serviceSchema}
  bodyClass="has-mobile-cta"
>
  <Header />

  <main class="w-full px-5 md:px-12 pt-8 md:pt-16 pb-12 md:pb-24">
    <div class="max-w-7xl mx-auto flex flex-col gap-12 md:gap-16">
      {/* ===== HERO ===== */}
      <section class="flex flex-col gap-4">
        <nav
          class="flex items-center gap-2 text-sm text-gray-500 mb-2 md:mb-4 font-medium"
        >
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="opacity-40"
            ><polyline points="9 18 15 12 9 6"></polyline></svg
          >
          <span class="text-gray-400">Contratos</span>
        </nav>

        <div
          class="inline-flex items-center gap-2 bg-primary/10 px-3 py-1.5 rounded-full w-fit"
        >
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-primary"
            >Para Empresas</span
          >
        </div>

        <h1
          class="text-3xl md:text-5xl lg:text-6xl text-white font-black leading-[1.1] tracking-tight max-w-4xl"
        >
          Sua empresa não<br class="hidden md:block" />
          pode <span class="text-primary">parar</span>
        </h1>
        <p class="text-gray-400 text-base md:text-lg leading-relaxed max-w-2xl">
          Suporte técnico ágil, otimização contínua de desempenho, manutenção
          física preventiva e help desk prioritário por um valor mensal fixo. <strong
            class="text-white">Sem sustos, sem horas extras.</strong
          >
        </p>

        <div class="flex flex-wrap gap-4 mt-4">
          <a
            href="#quiz"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-base h-14 px-8 shadow-lg transition-all hover:scale-105 active:scale-95"
          >
            <span class="material-symbols-outlined">monitoring</span>
            <span>Diagnóstico Gratuito</span>
          </a>
          <a
            href="#planos"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-base h-14 px-8 border border-white/10 transition-all hover:scale-105 active:scale-95"
          >
            <span>Ver Planos</span>
            <span class="material-symbols-outlined">arrow_forward</span>
          </a>
        </div>
      </section>

      {/* ===== QUIZ RADAR ===== */}
      <section
        id="quiz"
        class="relative overflow-hidden rounded-[2rem] border border-primary/20 bg-surface-dark"
      >
        <div
          class="absolute -top-20 -right-20 w-64 h-64 rounded-full opacity-10 pointer-events-none"
          style="background: radial-gradient(circle, #f65e37 0%, transparent 70%);"
        >
        </div>
        <div
          class="absolute -bottom-20 -left-20 w-48 h-48 rounded-full opacity-5 pointer-events-none"
          style="background: radial-gradient(circle, #f65e37 0%, transparent 70%);"
        >
        </div>

        <div
          id="quiz-container"
          class="relative z-10 p-8 md:p-10 lg:p-12"
          data-max-risk={quizSteps.length * 9}
        >
          <div class="flex items-center gap-2 mb-6">
            <span class="material-symbols-outlined text-primary">speed</span>
            <span
              class="text-xs font-bold uppercase tracking-widest text-primary"
              >Diagnóstico Rápido</span
            >
          </div>

          <h2
            class="text-2xl md:text-3xl font-black text-white mb-2 tracking-tight"
          >
            Qual o nível de risco da sua empresa?
          </h2>
          <p class="text-gray-400 text-sm md:text-base mb-8 max-w-xl">
            Responda 4 perguntas rápidas e descubra. Leva menos de 1 minuto.
          </p>

          {/* Steps indicator */}
          <div class="flex gap-2 mb-8" id="steps-bar">
            {
              quizSteps.map((_, i) => (
                <div
                  class="step-dot h-1.5 flex-1 rounded-full transition-all duration-500"
                  style={`background: ${i === 0 ? "#f65e37" : "rgba(255,255,255,0.1)"}`}
                />
              ))
            }
          </div>

          {/* Quiz content */}
          <div id="quiz-content">
            {
              quizSteps.map((step, i) => (
                <div
                  class={`quiz-step ${i === 0 ? "" : "hidden"}`}
                  data-step={i}
                >
                  <p class="text-gray-400 text-sm font-medium mb-3">
                    Passo {i + 1} de {quizSteps.length}
                  </p>
                  <h3 class="text-xl md:text-2xl font-bold text-white mb-6">
                    {step.question}
                  </h3>
                  <div class="flex flex-col gap-3">
                    {step.options.map((opt) => (
                      <button
                        class="quiz-option group text-left w-full p-4 md:p-5 rounded-xl border border-white/10 bg-black/40 hover:border-primary/50 hover:bg-primary/5 transition-all duration-300 flex items-center justify-between cursor-pointer"
                        data-risk={opt.risk}
                        data-step={i}
                      >
                        <span class="text-white font-medium group-hover:text-primary transition-colors">
                          {opt.label}
                        </span>
                        <span class="material-symbols-outlined text-gray-500 group-hover:text-primary transition-colors">
                          arrow_forward
                        </span>
                      </button>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>

          {/* Result */}
          <div id="quiz-result" class="hidden">
            <div class="flex flex-col items-center text-center py-8">
              <div class="mb-6 relative">
                <svg class="w-32 h-32 -rotate-90" viewBox="0 0 120 120">
                  <circle
                    cx="60"
                    cy="60"
                    r="54"
                    fill="none"
                    stroke="rgba(255,255,255,0.1)"
                    stroke-width="8"></circle>
                  <circle
                    id="risk-ring"
                    cx="60"
                    cy="60"
                    r="54"
                    fill="none"
                    stroke="#f65e37"
                    stroke-width="8"
                    stroke-linecap="round"
                    stroke-dasharray="339.292"
                    stroke-dashoffset="339.292"></circle>
                </svg>
                <div class="absolute inset-0 flex items-center justify-center">
                  <span
                    id="risk-percent"
                    class="text-4xl md:text-5xl font-black text-white">0%</span
                  >
                </div>
              </div>
              <h3 id="risk-title" class="text-2xl font-bold text-white mb-2">
                Risco Calculado
              </h3>
              <p id="risk-desc" class="text-gray-400 max-w-md mb-8"></p>

              <a
                id="quiz-cta"
                href="https://wa.me/555193257923?text=Ol%C3%A1%21%20Fiz%20o%20diagn%C3%B3stico%20de%20risco%20no%20site%20da%20Sigel%20e%20gostaria%20de%20receber%20um%20diagn%C3%B3stico%20completo%20gratuito%20para%20minha%20empresa."
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-base h-14 px-10 shadow-lg transition-all hover:scale-105 active:scale-95 animate-pulse"
              >
                <span class="material-symbols-outlined">chat</span>
                <span>Quero um Diagnóstico Completo Grátis</span>
              </a>
              <button
                id="quiz-restart"
                class="mt-4 text-sm text-gray-500 hover:text-white transition-colors cursor-pointer underline underline-offset-2"
              >
                Refazer o teste
              </button>
            </div>
          </div>
        </div>
      </section>

      {/* ===== PROBLEM / SOLUTION ===== */}
      <section class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
        <div
          class="rounded-2xl border border-red-900/40 bg-red-950/20 p-8 md:p-10"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="material-symbols-outlined text-red-400 text-3xl"
              >warning</span
            >
            <h3 class="text-xl font-bold text-white">Modelo Reativo</h3>
          </div>
          <ul class="flex flex-col gap-3">
            <li
              class="flex items-start gap-3 text-gray-400 text-sm leading-relaxed"
            >
              <span
                class="material-symbols-outlined text-red-400 text-lg shrink-0"
                >close</span
              >
              <span
                >Custo imprevisível: perdas que podem superar R$ 500/dia com
                máquina parada</span
              >
            </li>
            <li
              class="flex items-start gap-3 text-gray-400 text-sm leading-relaxed"
            >
              <span
                class="material-symbols-outlined text-red-400 text-lg shrink-0"
                >close</span
              >
              <span
                >PC acumula lentidão, poeira e trava na hora que você mais
                precisa</span
              >
            </li>
            <li
              class="flex items-start gap-3 text-gray-400 text-sm leading-relaxed"
            >
              <span
                class="material-symbols-outlined text-red-400 text-lg shrink-0"
                >close</span
              >
              <span
                >Espera por técnico avulso, horas extras e estresse na rotina</span
              >
            </li>
          </ul>
        </div>
        <div
          class="rounded-2xl border border-primary/20 bg-primary/5 p-8 md:p-10"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="material-symbols-outlined text-primary text-3xl"
              >verified</span
            >
            <h3 class="text-xl font-bold text-white">Modelo Preventivo</h3>
          </div>
          <ul class="flex flex-col gap-3">
            <li
              class="flex items-start gap-3 text-gray-400 text-sm leading-relaxed"
            >
              <span
                class="material-symbols-outlined text-primary text-lg shrink-0"
                >check</span
              >
              <span
                >Custo fixo previsível: <strong class="text-white"
                  >R$ 97 a R$ 497/mês</strong
                ></span
              >
            </li>
            <li
              class="flex items-start gap-3 text-gray-400 text-sm leading-relaxed"
            >
              <span
                class="material-symbols-outlined text-primary text-lg shrink-0"
                >check</span
              >
              <span
                >Otimização periódica de desempenho e limpeza do sistema</span
              >
            </li>
            <li
              class="flex items-start gap-3 text-gray-400 text-sm leading-relaxed"
            >
              <span
                class="material-symbols-outlined text-primary text-lg shrink-0"
                >check</span
              >
              <span
                >Suporte remoto em <strong class="text-white">minutos</strong> + manutenção
                física</span
              >
            </li>
          </ul>
        </div>
      </section>

      {/* ===== BENEFITS ===== */}
      <section class="flex flex-col gap-6">
        <div class="max-w-2xl">
          <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight">
            O que está incluso
          </h2>
          <p class="text-gray-400 mt-2 text-base">
            Mais do que manutenção — uma operação de TI completa para sua
            empresa.
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6"
        >
          <div
            class="group relative p-6 md:p-8 rounded-2xl border border-gray-800 bg-surface-dark transition-all duration-500 hover:border-primary/30 hover:-translate-y-1"
          >
            <div
              class="shrink-0 size-12 md:size-14 rounded-xl bg-primary/10 flex items-center justify-center text-primary mb-5"
            >
              <span class="material-symbols-outlined text-2xl md:text-3xl"
                >headset_mic</span
              >
            </div>
            <h3 class="font-bold text-lg text-white mb-2 tracking-tight">
              Help Desk & Suporte Remoto
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Atendimento ágil no WhatsApp para resolver travamentos,
              impressoras, e-mails, rede e dúvidas do dia a dia.
            </p>
          </div>
          <div
            class="group relative p-6 md:p-8 rounded-2xl border border-gray-800 bg-surface-dark transition-all duration-500 hover:border-primary/30 hover:-translate-y-1"
          >
            <div
              class="shrink-0 size-12 md:size-14 rounded-xl bg-primary/10 flex items-center justify-center text-primary mb-5"
            >
              <span class="material-symbols-outlined text-2xl md:text-3xl"
                >speed</span
              >
            </div>
            <h3 class="font-bold text-lg text-white mb-2 tracking-tight">
              Otimização Periódica
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Limpeza de arquivos temporários, ajuste de inicialização e rotinas
              para manter o computador sempre rápido.
            </p>
          </div>
          <div
            class="group relative p-6 md:p-8 rounded-2xl border border-gray-800 bg-surface-dark transition-all duration-500 hover:border-primary/30 hover:-translate-y-1"
          >
            <div
              class="shrink-0 size-12 md:size-14 rounded-xl bg-primary/10 flex items-center justify-center text-primary mb-5"
            >
              <span class="material-symbols-outlined text-2xl md:text-3xl"
                >cleaning_services</span
              >
            </div>
            <h3 class="font-bold text-lg text-white mb-2 tracking-tight">
              Limpeza Física & Térmica
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Desobstrução de coolers e troca periódica de pasta térmica para
              evitar superaquecimento e queima de peças.
            </p>
          </div>
          <div
            class="group relative p-6 md:p-8 rounded-2xl border border-gray-800 bg-surface-dark transition-all duration-500 hover:border-primary/30 hover:-translate-y-1"
          >
            <div
              class="shrink-0 size-12 md:size-14 rounded-xl bg-primary/10 flex items-center justify-center text-primary mb-5"
            >
              <span class="material-symbols-outlined text-2xl md:text-3xl"
                >memory</span
              >
            </div>
            <h3 class="font-bold text-lg text-white mb-2 tracking-tight">
              Consultoria de Upgrades
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Diagnóstico da saúde das peças e recomendação de upgrades (SSD,
              RAM) para investir com segurança.
            </p>
          </div>
        </div>
      </section>

      {/* ===== PLANOS ===== */}
      <section id="planos" class="flex flex-col gap-6 md:gap-10 pt-6">
        <div class="text-center max-w-2xl mx-auto mb-2 md:mb-4">
          <div
            class="inline-flex items-center gap-2 bg-primary/10 px-3 py-1.5 rounded-full w-fit mx-auto mb-4"
          >
            <span
              class="text-xs font-bold uppercase tracking-wider text-primary"
              >Planos</span
            >
          </div>
          <h2
            class="text-2xl md:text-3xl lg:text-4xl font-black text-white tracking-tight"
          >
            Escolha o plano ideal para sua empresa
          </h2>
          <p class="text-gray-400 mt-3 text-base leading-relaxed">
            Todos os planos incluem suporte remoto ágil, otimização contínua de
            sistema e consultoria técnica. Cancele quando quiser, sem multa.
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 pt-4 md:pt-6"
        >
          {
            planos.map((plano) => (
              <div
                class={`relative flex flex-col rounded-2xl border p-8 transition-all duration-300 hover:-translate-y-1 ${
                  plano.highlight
                    ? "border-primary/40 bg-primary/5 shadow-lg shadow-primary/10 md:scale-105 z-10 my-3 md:my-0"
                    : "border-gray-800 bg-surface-dark hover:border-gray-600"
                }`}
              >
                {plano.highlight && (
                  <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-primary text-white text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full shadow-lg">
                    Mais Popular
                  </div>
                )}
                <div class="mb-2">
                  <span
                    class={`text-xs font-bold uppercase tracking-widest ${plano.highlight ? "text-primary" : "text-gray-500"}`}
                  >
                    {plano.tagline}
                  </span>
                </div>
                <h3 class="text-2xl font-black text-white">{plano.name}</h3>
