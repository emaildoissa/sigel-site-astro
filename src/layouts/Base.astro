---
import "../styles/global.css";

interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: "website" | "article";
  canonical?: string;
  schema?: string;
  robots?: string;
  breadcrumbs?: Breadcrumb[];
  preloadImages?: string[];
  bodyClass?: string;
}

const {
  title,
  description,
  ogImage,
  ogType = "website",
  canonical,
  schema,
  robots = "index, follow",
  breadcrumbs,
  preloadImages,
  bodyClass,
} = Astro.props;
const siteUrl = "https://sigelinformatica.com.br";
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : siteUrl;
const ogImageUrl = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : `${siteUrl}${ogImage}`
  : `${siteUrl}/images/logo.webp`;

const breadcrumbSchema = breadcrumbs
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
        ...breadcrumbs.map((b, i) => ({
          "@type": "ListItem" as const,
          position: i + 2,
          name: b.name,
          item: `${siteUrl}${b.path}`,
        })),
      ],
    }
  : null;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Sigel Soluções em Informática",
  image: `${siteUrl}/images/logo.webp`,
  url: siteUrl,
  telephone: "+5551993257923",
  email: "contato@sigelinformatica.com.br",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Av. Icaraí, 1428 - Cristal",
    addressLocality: "Porto Alegre",
    addressRegion: "RS",
    addressCountry: "BR",
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    {
      preloadImages?.map((img) => (
        <link rel="preload" as="image" href={img} fetchpriority="high" />
      ))
    }

    {
      preloadImages?.some((img) => img.includes("unsplash.com")) && (
        <link rel="preconnect" href="https://images.unsplash.com" />
      )
    }

    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema)}
    />
    {
      breadcrumbSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbSchema)}
        />
      )
    }
    {schema && <script type="application/ld+json" set:html={schema} />}

    <!-- Fontes Google -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Material Symbols -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
      />
    </noscript>

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=AW-1002033487"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag("js", new Date());

      gtag("config", "G-YEFCC96J8B");
      gtag("config", "AW-1002033487");

      function gtag_report_conversion(url) {
        var callback = function () {
          if (typeof url != "undefined" && url) {
            window.location = url;
          }
        };
        gtag("event", "conversion", {
          send_to: "AW-1002033487/WS7uCITI--gcEM-i590D",
          value: 1.0,
          currency: "BRL",
          event_callback: callback,
        });
        return false;
      }
      window.gtag_report_conversion = gtag_report_conversion;

      window.trackLeadConversion = function (channel, details) {
        try {
          window.dataLayer.push({
            event: "lead_conversion",
            conversion_channel: channel || "whatsapp",
            conversion_details: details || window.location.pathname,
          });

          gtag("event", "generate_lead", {
            event_category: "contact",
            event_label: channel || "whatsapp",
            page_path: window.location.pathname,
          });

          gtag_report_conversion();
        } catch (err) {
          console.debug("Conversion tracking notice:", err);
        }
      };

      // --- SIGEL CRM: Rastreamento Inteligente de Origem de Leads (Google Ads / Meta Ads / Site) ---
      const SIGEL_STORAGE_KEY = "sigel_lead_source";

      function detectLeadOrigin() {
        const params = new URLSearchParams(window.location.search);
        const utmSource = (params.get("utm_source") || "").toLowerCase();
        const utmMedium = (params.get("utm_medium") || "").toLowerCase();
        const gclid = params.get("gclid");
        const gbraid = params.get("gbraid");
        const wbraid = params.get("wbraid");
        const fbclid = params.get("fbclid");

        const hasAdParams = Boolean(
          gclid || gbraid || wbraid || fbclid || utmSource || utmMedium
        );

        // Se NÃO há novos parâmetros de tráfego na URL, reaproveita a origem salva da sessão
        if (!hasAdParams) {
          try {
            const saved = sessionStorage.getItem(SIGEL_STORAGE_KEY);
            if (saved) return saved;
          } catch (e) {}
        }

        let origin = "Site";

        // Google Ads: gclid, gbraid, wbraid ou UTMs de tráfego pago do Google
        if (
          gclid ||
          gbraid ||
          wbraid ||
          (utmSource.includes("google") &&
            (utmMedium.includes("cpc") ||
              utmMedium.includes("ads") ||
              utmMedium.includes("paid")))
        ) {
          origin = "Google Ads";
        }
        // Meta Ads: fbclid ou UTMs pagas do Facebook/Instagram
        else if (
          fbclid ||
          ((utmSource.includes("meta") ||
            utmSource.includes("insta") ||
            utmSource.includes("face")) &&
            (utmMedium.includes("cpc") ||
              utmMedium.includes("ads") ||
              utmMedium.includes("paid")))
        ) {
          origin = "Meta Ads";
        }
        // Outros anúncios pagos
        else if (
          utmMedium.includes("cpc") ||
          utmMedium.includes("ads") ||
          utmMedium.includes("paid")
        ) {
          origin = utmSource ? `Anúncio (${utmSource})` : "Anúncio Pago";
        }
        // Tráfego de busca orgânica
        else if (document.referrer && document.referrer.includes("google.")) {
          origin = "Google Orgânico";
        }
        // Tráfego de redes sociais orgânico
        else if (
          document.referrer &&
          (document.referrer.includes("instagram.") ||
            document.referrer.includes("facebook."))
        ) {
          origin = "Redes Sociais";
        }
        // Acesso direto ou pelo site institucional
        else {
          origin = "Site";
        }

        try {
          sessionStorage.setItem(SIGEL_STORAGE_KEY, origin);
        } catch (e) {}

        return origin;
      }

      function getRefTag(origin) {
        if (origin === "Google Ads") return "(Ref: #SG-GAD)";
        if (origin === "Meta Ads") return "(Ref: #SG-MET)";
        return "(Ref: #SG-WEB)";
      }

      function appendOriginToHref(rawHref) {
        if (!rawHref) return rawHref;
        if (!rawHref.includes("wa.me") && !rawHref.includes("whatsapp.com"))
          return rawHref;

        try {
          const decodedHref = decodeURIComponent(rawHref);
          if (
            decodedHref.includes("#SG-") ||
            decodedHref.includes("[Origem:") ||
            decodedHref.includes("Ref: #SG-")
          ) {
            return rawHref;
          }
        } catch (e) {}

        try {
          const url = new URL(rawHref, window.location.href);

          // Ignorar links de compartilhamento geral sem número de destino
          const phoneDigits = (url.pathname || "").replace(/\D/g, "");
          if (phoneDigits.length < 8 && !url.searchParams.get("phone")) {
            return rawHref;
          }

          let text = url.searchParams.get("text") || "";
          if (
            text.includes("#SG-") ||
            text.includes("[Origem:") ||
            text.includes("Ref:")
          ) {
            return rawHref;
          }

          const origin = detectLeadOrigin();
          const tag = getRefTag(origin);

          if (!text.trim()) {
            text = "Olá! Gostaria de um orçamento para meu equipamento.";
          }
          url.searchParams.set("text", `${text.trim()} ${tag}`);
          return url.toString();
        } catch (e) {
          const origin = detectLeadOrigin();
          const tag = getRefTag(origin);
          const sep = rawHref.includes("?") ? "&" : "?";
          return `${rawHref}${sep}text=${encodeURIComponent(
            "Olá! Gostaria de um orçamento. " + tag
          )}`;
        }
      }

      function updateAllWhatsAppLinks() {
        const links = document.querySelectorAll(
          'a[href*="wa.me"], a[href*="whatsapp.com"], [data-whatsapp-btn]'
        );
        links.forEach((link) => {
          const currentHref = link.getAttribute("href");
          if (currentHref) {
            try {
              const decoded = decodeURIComponent(currentHref);
              if (!decoded.includes("#SG-") && !decoded.includes("[Origem:")) {
                const newHref = appendOriginToHref(currentHref);
                if (newHref !== currentHref) {
                  link.setAttribute("href", newHref);
                }
              }
            } catch (e) {}
          }
        });
      }

      // Inicializar detecção e escaneamento inicial do DOM
      detectLeadOrigin();
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", updateAllWhatsAppLinks);
      } else {
        updateAllWhatsAppLinks();
      }

      window.addEventListener("popstate", updateAllWhatsAppLinks);
      document.addEventListener("astro:page-load", updateAllWhatsAppLinks);

      // Expor utilitário global para Astro e botões dinâmicos
      window.SigelTracker = {
        getOrigin: detectLeadOrigin,
        refresh: updateAllWhatsAppLinks,
        buildUrl: function (phoneNumber, baseMessage) {
          const cleanPhone = (phoneNumber || "5551993257923").replace(/\D/g, "");
          const origin = detectLeadOrigin();
          const tag = getRefTag(origin);
          const msg = `${baseMessage || "Olá! Gostaria de um orçamento."} ${tag}`;
          return `https://wa.me/${cleanPhone}?text=${encodeURIComponent(msg)}`;
        },
      };

      // Interceptor de cliques em links (useCapture para rodar antes da navegação do navegador)
      document.addEventListener(
        "click",
        (e) => {
          const target = e.target.closest("a");
          if (!target) return;
          const href = target.getAttribute("href") || "";
          if (href.includes("wa.me") || href.includes("whatsapp.com")) {
            const updatedHref = appendOriginToHref(href);
            if (updatedHref !== href) {
              target.setAttribute("href", updatedHref);
              e.preventDefault();
              const targetWindow = target.getAttribute("target") || "_blank";
              window.open(updatedHref, targetWindow);
            }
            window.trackLeadConversion("whatsapp", updatedHref);
          } else if (href.startsWith("tel:")) {
            window.trackLeadConversion("phone_call", href);
          }
        },
        true
      );
    </script>
  </head>

  <body class={bodyClass}>
    <slot />
  </body>
</html>
