---
import "../styles/global.css";

interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: "website" | "article";
  canonical?: string;
  schema?: string;
  robots?: string;
  breadcrumbs?: Breadcrumb[];
  preloadImages?: string[];
  bodyClass?: string;
}

const {
  title,
  description,
  ogImage,
  ogType = "website",
  canonical,
  schema,
  robots = "index, follow",
  breadcrumbs,
  preloadImages,
  bodyClass,
} = Astro.props;
const siteUrl = "https://sigelinformatica.com.br";
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : siteUrl;
const ogImageUrl = ogImage ? (ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`) : `${siteUrl}/images/logo.webp`;

const breadcrumbSchema = breadcrumbs
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        ...breadcrumbs.map((b, i) => ({
          "@type": "ListItem" as const,
          "position": i + 2,
          "name": b.name,
          "item": `${siteUrl}${b.path}`,
        })),
      ],
    }
  : null;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Sigel Soluções em Informática",
  "image": `${siteUrl}/images/logo.webp`,
  "url": siteUrl,
  "telephone": "+5551993257923",
  "email": "contato@sigelinformatica.com.br",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Av. Icaraí, 1428 - Cristal",
    "addressLocality": "Porto Alegre",
    "addressRegion": "RS",
    "addressCountry": "BR"
  }
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    {preloadImages?.map((img) => (
      <link rel="preload" as="image" href={img} fetchpriority="high" />
    ))}

    {preloadImages?.some(img => img.includes("unsplash.com")) && (
      <link rel="preconnect" href="https://images.unsplash.com" />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {schema && <script type="application/ld+json" set:html={schema} />}

    <!-- Fontes Google -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap"
      rel="stylesheet"
      media="print" onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
    </noscript>

    <!-- Material Symbols -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
      media="print" onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    </noscript>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-1002033487"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-YEFCC96J8B');
      gtag('config', 'AW-1002033487');
    </script>

    <!-- Global Conversion Tracker for Google Ads & GA4 -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };

      window.trackLeadConversion = function(channel, details) {
        try {
          window.dataLayer.push({
            event: 'lead_conversion',
            conversion_channel: channel || 'whatsapp',
            conversion_details: details || window.location.pathname
          });

          window.gtag('event', 'generate_lead', {
            event_category: 'contact',
            event_label: channel || 'whatsapp',
            page_path: window.location.pathname
          });

          window.gtag('event', 'conversion', {
            send_to: 'AW-1002033487/WS7uCITI--gcEM-i590D',
            value: 1.0,
            currency: 'BRL'
          });
        } catch (err) {
          console.debug('Conversion tracking notice:', err);
        }
      };

      document.addEventListener('DOMContentLoaded', () => {
        document.addEventListener('click', (e) => {
          const target = e.target.closest('a');
          if (!target) return;
          const href = target.getAttribute('href') || '';
          if (href.includes('wa.me') || href.includes('whatsapp.com')) {
            window.trackLeadConversion('whatsapp', href);
          } else if (href.startsWith('tel:')) {
            window.trackLeadConversion('phone_call', href);
          }
        });
      });
    </script>
  </head>

  <body class={bodyClass}>
    <slot />
  </body>
</html>
